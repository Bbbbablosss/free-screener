# Heleket payment integration — ENVIRONMENT TEMPLATE (placeholders only).
#
# ⚠️  DO NOT put the real API key in this file or anywhere under git.
#     The real secret lives ONLY in /etc/screener/payments.env on the server
#     (root-owned, chmod 600), loaded by systemd via EnvironmentFile=.
#
# On the server:
#   sudo install -m 600 -o root -g root /dev/null /etc/screener/payments.env
#   sudo nano /etc/screener/payments.env      # paste the real values below
#   sudo systemctl daemon-reload && sudo systemctl restart screener
#
# Required
HELEKET_API_KEY=__PUT_THE_REAL_PAYMENT_API_KEY_HERE__
HELEKET_MERCHANT_ID=__YOUR_MERCHANT_UUID__

# Optional (sane defaults in code)
# HELEKET_API_URL=https://api.heleket.com/v1
# EN/ES price table override
# PRO_PLAN_PRICES={"1": 99.0, "3": 282.15, "6": 534.6, "12": 1009.8}
# RU/UK price table override
# PRO_PLAN_PRICES_RU_UK={"1": 55.0, "3": 156.75, "6": 297.0, "12": 561.0}
# PRO_CURRENCY=USD
# HELEKET_INVOICE_LIFETIME=3600
# PAY_PUBLIC_BASE_URL=https://cryptoscreener.live
# HELEKET_WEBHOOK_IPS=31.133.220.8
# HELEKET_STRICT_IP=0
