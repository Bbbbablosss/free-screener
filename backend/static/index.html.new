let currentLang = localStorage.getItem('crypto_lang');
if (!currentLang) {
  const navLang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
  currentLang = navLang.startsWith('es') ? 'es' : 'en';
  localStorage.setItem('crypto_lang', currentLang);
}
if (currentLang !== 'en' && currentLang !== 'es') currentLang = 'en';

function t(key) {
  return (TRANSLATIONS[currentLang] || TRANSLATIONS.en)[key] || key;
}

function applyTranslations() {
  const T = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
  // Top nav
  const navMap = {
    'nav-charts':     T.charts,
    'nav-screener':   'Screener',
    'nav-densities':  T.densities,
    'nav-splash':     T.spike,
    'nav-arbitrage':  T.arbitrage,
    'nav-premium':    T.premium,
    'nav-listings':   T.listings,
  };
  Object.entries(navMap).forEach(([id, label]) => {
    const el = document.querySelector('#' + id + ' .sb-nav-item-label');
    if (el) el.textContent = label;
  });
  // Params panel
  const ppBtn = document.getElementById('ch-wl-menu-btn-label');
  if (ppBtn) ppBtn.textContent = T.ch_params_btn || 'Settings';
  const ppTitle = document.getElementById('ch-pp-title');
  if (ppTitle) ppTitle.textContent = T.ch_params_title || 'Parameter list';
  const ppLabelMap = {
    price_change: T.ch_param_price_change,
    volume:       T.ch_param_volume,
    vol_spike:    T.ch_param_vol_spike,
    trade_spike:  T.ch_param_trade_spike,
    trades:       T.ch_param_trades,
    natr:         T.ch_param_natr,
  };
  document.querySelectorAll('[data-param-label]').forEach(el => {
    const lbl = ppLabelMap[el.dataset.paramLabel];
    if (lbl) el.textContent = lbl;
  });
  // Lang button
  const langVal = document.getElementById('sb-lang-val');
  if (langVal) langVal.textContent = currentLang === 'en' ? 'En' : 'Es';
  const langLbl = document.querySelector('.sb-lang-label');
  if (langLbl) langLbl.textContent = T.language;
  // Stats bar
  const lbls = {
    'stat-total': T.total_densities,
  };
  document.querySelectorAll('.stat-lbl').forEach(el => {
    const txt = el.textContent.trim().toLowerCase();
    if (txt === 'total densities' || txt === 'total densidades') el.textContent = T.total_densities;
    else if (txt === 'pairs active' || txt === 'pares activos')  el.textContent = T.pairs_active;
  });
  // Mode buttons
  const binBtn = document.getElementById('sp-mode-binance-btn');
  const allBtn = document.getElementById('sp-mode-all-btn');
  const rwaBtn = document.getElementById('sp-mode-hide-rwa-btn');
  if (binBtn) binBtn.textContent = T.only_binance;
  if (allBtn) allBtn.textContent = T.crypto;
  if (rwaBtn) rwaBtn.textContent = T.rwa;
  // Settings section titles
  document.querySelectorAll('.sp-section-title').forEach(el => {
    const txt = el.textContent.trim().toLowerCase();
    if (txt === 'mode' || txt === 'modo')                             el.textContent = T.mode;
    else if (txt === 'quote currencies' || txt === 'monedas de cotización') el.textContent = T.quote_currencies;
    else if (txt === 'exchanges')                                     el.textContent = T.exchanges;
  });
  // Filterbar: Exchange / Market / Side labels
  const exchLbl = document.querySelector('#fdd-exchange-trigger .fdd-lbl');
  const mktLbl  = document.querySelector('#fdd-market-trigger .fdd-lbl');
  const sideLbl = document.querySelector('#fdd-side-trigger .fdd-lbl');
  if (exchLbl) exchLbl.textContent = T.lbl_exchange;
  if (mktLbl)  mktLbl.textContent  = T.lbl_market;
  if (sideLbl) sideLbl.textContent = T.lbl_side;

  // Filterbar: dropdown values
  const exchVal = document.getElementById('fdd-exchange-val');
  const mktVal  = document.getElementById('fdd-market-val');
  const sideVal = document.getElementById('fdd-side-val');
  if (exchVal && (exchVal.textContent === 'All' || exchVal.textContent === 'Todo')) exchVal.textContent = T.val_all;
  if (mktVal) {
    const mv = mktVal.textContent.trim();
    if (mv === 'All' || mv === 'Todo') mktVal.textContent = T.val_all;
    else if (mv === 'Perp') mktVal.textContent = T.val_perp;
    else if (mv === 'Spot') mktVal.textContent = T.val_spot;
  }
  if (sideVal) {
    const sv = sideVal.textContent.trim();
    if (sv === 'All' || sv === 'Todo') sideVal.textContent = T.val_all;
    else if (sv === 'Bid' || sv === 'Compra') sideVal.textContent = T.val_bid;
    else if (sv === 'Ask' || sv === 'Venta')  sideVal.textContent = T.val_ask;
  }

  // Translate dropdown menu items (All / Bid / Ask / Perp / Spot)
  const valMap = { all: T.val_all, bid: T.val_bid, ask: T.val_ask, perp: T.val_perp, spot: T.val_spot };
  ['fdd-market-menu','fdd-side-menu','fdd-exchange-menu'].forEach(menuId => {
    const menu = document.getElementById(menuId);
    if (!menu) return;
    menu.querySelectorAll('.fdd-item').forEach(item => {
      const val = item.dataset.val;
      if (valMap[val]) {
        // preserve child nodes (icon spans), only update text node
        const textNode = [...item.childNodes].find(n => n.nodeType === 3 && n.textContent.trim());
        if (textNode) textNode.textContent = valMap[val];
        else if (valMap[val]) item.lastChild.textContent = valMap[val];
      }
    });
  });

  // Customize button in statsbar (density) — skip spike settings btn
  document.querySelectorAll('.stats-customize:not(#splash-settings-btn)').forEach(el => {
    const tn = [...el.childNodes].find(n => n.nodeType === 3 && n.textContent.trim());
    if (tn) tn.textContent = '\n        ' + T.customize + '\n      ';
  });
  // Spike settings button
  const spikeBtn = document.getElementById('splash-settings-btn');
  if (spikeBtn) {
    const tn = [...spikeBtn.childNodes].find(n => n.nodeType === 3 && n.textContent.trim());
    if (tn) tn.textContent = '\n        ' + T.spike_settings_btn + '\n      ';
  }
  // Settings panel title
  document.querySelectorAll('.sp-title').forEach(el => {
    if (el.textContent.trim() === 'Customize' || el.textContent.trim() === 'Personalizar')
      el.textContent = T.customize;
  });

  // Filterbar search placeholder
  const searchBox = document.querySelector('#search-input');
  if (searchBox) searchBox.placeholder = T.search_ph;
  const chWlSearch = document.getElementById('ch-wl-search-inp');
  if (chWlSearch) chWlSearch.placeholder = T.ch_ticker_search_ph;
  const chWlListSearch = document.getElementById('ch-wl-list-search');
  if (chWlListSearch) chWlListSearch.placeholder = T.ch_list_search_ph || 'Search…';

  // Settings section titles (Sort, Distance %, Wall Age, Min Size, Card Style, Sound, Coin List)
  document.querySelectorAll('.sp-section-title').forEach(el => {
    const txt = el.textContent.trim();
    const map = {
      'Sort':'sort','Ordenar':'sort',
      'Distance %':'distance_pct','Distancia %':'distance_pct',
      'Wall Age':'wall_age','Edad del Muro':'wall_age',
      'Min Size (S / F)':'min_size','Tamaño Mín (S / F)':'min_size',
      'Card Style':'card_style','Estilo de Tarjeta':'card_style',
      'Sound':'sound','Sonido':'sound',
      'Coin List':'coin_list','Lista de Monedas':'coin_list',
    };
    if (map[txt]) el.textContent = T[map[txt]];
  });

  // Sort select options
  const sortSel = document.getElementById('sp-sort-select');
  if (sortSel) {
    sortSel.querySelectorAll('option').forEach(o => {
      if (o.value === 'time')     o.textContent = T.by_time;
      if (o.value === 'volume')   o.textContent = T.by_volume;
      if (o.value === 'distance') o.textContent = T.by_distance;
    });
  }

  // Wall Age: From / To labels & unit dropdowns
  document.querySelectorAll('.sp-time-label').forEach(el => {
    if (el.textContent === 'From' || el.textContent === 'Desde') el.textContent = T.from;
    if (el.textContent === 'To'   || el.textContent === 'Hasta') el.textContent = T.to;
  });
  document.querySelectorAll('select.sp-time-unit').forEach(sel => {
    sel.querySelectorAll('option').forEach(o => {
      if (o.value === 'minutes') o.textContent = T.minutes;
      if (o.value === 'seconds') o.textContent = T.seconds;
      if (o.value === 'hours')   o.textContent = T.hours;
      if (o.value === 'days')    o.textContent = T.days;
    });
  });

  // $ from labels in Card Style
  document.querySelectorAll('.cs-tier-thresh-label').forEach(el => {
    if (el.textContent === '$ from' || el.textContent === '$ desde') el.textContent = T.usd_from;
  });

  // Coin List: Add Coin, Search
  document.querySelectorAll('.sp-add-coin-btn').forEach(btn => {
    const tn = [...btn.childNodes].find(n => n.nodeType === 3 && n.textContent.trim());
    if (tn) tn.textContent = ' ' + T.add_coin;
    else {
      const txt = btn.textContent.trim();
      if (txt === 'Add Coin' || txt === 'Añadir') btn.textContent = T.add_coin;
    }
  });
  const coinSearch = document.querySelector('#sp-coin-search');
  if (coinSearch) coinSearch.placeholder = T.search_coin;

  // Alert sound label
  document.querySelectorAll('label, span').forEach(el => {
    const txt = el.textContent.trim();
    if (txt === 'Alert sound' || txt === 'Sonido de alerta') el.textContent = T.alert_sound;
  });

  // Sound type buttons (Chime, Bell, Drop, Pulse — these stay same, just spike panel)
  const sndNotifLbl = document.querySelector('.ssp-lbl');
  if (sndNotifLbl && (sndNotifLbl.textContent === 'Sound Notifications' || sndNotifLbl.textContent === 'Notificaciones de Sonido'))
    sndNotifLbl.textContent = T.sound_notif;

  // Cancel / Save / Reset buttons
  const cancelBtn = document.getElementById('sp-cancel');
  const saveBtn   = document.getElementById('sp-save');
  const resetBtn  = document.getElementById('sp-reset');
  if (cancelBtn) cancelBtn.textContent = T.cancel;
  if (saveBtn)   saveBtn.textContent   = T.save;
  if (resetBtn) {
    const tn = [...resetBtn.childNodes].find(n => n.nodeType === 3 && n.textContent.trim());
    if (tn) tn.textContent = '\n        ' + T.reset_settings + '\n      ';
    else resetBtn.textContent = T.reset_settings;
  }

  // Unsaved dialog
  const unsavedBox = document.querySelector('#sp-unsaved-box p');
  if (unsavedBox) unsavedBox.innerHTML = `<strong>${T.unsaved_title}</strong><br>${T.unsaved_body}`;
  const exitBtn = document.getElementById('sp-unsaved-exit');
  const saveBtn2 = document.getElementById('sp-unsaved-save');
  if (exitBtn)  exitBtn.textContent  = T.exit;
  if (saveBtn2) saveBtn2.textContent = T.save;

  // Spike settings panel
  const sspTitle = document.querySelector('.ssp-title');
  if (sspTitle) sspTitle.textContent = T.ssp_title;
  document.querySelectorAll('.ssp-lbl').forEach(el => {
    const txt = el.textContent.trim();
    if (txt === 'Thresholds'  || txt === 'Umbrales')               el.textContent = T.ssp_thresholds;
    else if (txt === 'Exchanges' || txt === 'Intercambios')        el.textContent = T.exchanges;
    else if (txt === 'Min Vol 24h' || txt === 'Vol Mín 24h')       el.textContent = T.ssp_minvol;
    else if (txt === 'Sound Notifications' || txt === 'Notificaciones de Sonido') el.textContent = T.sound_notif;
  });

  // Workspace dropdown
  const wsRename = document.getElementById('ws-rename-btn');
  const wsDelete = document.getElementById('ws-delete-btn');
  const wsCreate = document.getElementById('ws-create-btn');
  const wsListLbl = document.querySelector('.ws-list-label');
  if (wsRename) { const tn = [...wsRename.childNodes].find(n => n.nodeType === 3 && n.textContent.trim()); if (tn) tn.textContent = ' ' + T.ws_rename; }
  if (wsDelete) { const tn = [...wsDelete.childNodes].find(n => n.nodeType === 3 && n.textContent.trim()); if (tn) tn.textContent = ' ' + T.ws_delete; }
  if (wsCreate) { const tn = [...wsCreate.childNodes].find(n => n.nodeType === 3 && n.textContent.trim()); if (tn) tn.textContent = ' ' + T.ws_create; }
  if (wsListLbl) wsListLbl.textContent = T.ws_list;

  // Workspace names (refresh display if default name)
  const wsNameEl = document.getElementById('ws-name');
  if (wsNameEl && typeof workspaces !== 'undefined') {
    wsNameEl.textContent = wsDisplayName(workspaces[wsActive] || 'Workspace 1');
    if (typeof renderWsList === 'function') renderWsList();
  }

  // Theme switcher labels
  const themeLbl = document.getElementById('sb-theme-label');
  if (themeLbl) themeLbl.textContent = T.theme || 'Theme';
  const themeNameGreen = document.getElementById('sb-theme-name-green');
  if (themeNameGreen) themeNameGreen.textContent = T.theme_green || 'Green';
  const themeNameBlue = document.getElementById('sb-theme-name-blue');
  if (themeNameBlue) themeNameBlue.textContent = T.theme_blue || 'Blue';
  const themeVal = document.getElementById('sb-theme-val');
  if (themeVal) themeVal.textContent = (typeof currentTheme !== 'undefined' && currentTheme === 'blue') ? (T.theme_blue || 'Blue') : (T.theme_green || 'Green');

  const profileBtn = document.getElementById('tb-profile-btn');
  if (profileBtn) profileBtn.title = T.profile;
  const profileLbl = document.getElementById('tb-profile-lbl-profile');
  const inviteLbl = document.getElementById('tb-profile-lbl-invite');
  const logoutLbl = document.getElementById('tb-profile-lbl-logout');
  if (profileLbl) profileLbl.textContent = T.profile;
  if (inviteLbl) inviteLbl.textContent = T.invite_friend;
  if (logoutLbl) logoutLbl.textContent = T.logout;

  const pfPageTitle = document.getElementById('pf-page-title');
  const pfSectionTitle = document.getElementById('pf-section-title');
  const pfTabAccount = document.getElementById('pf-tab-account');
  const pfTabInvite = document.getElementById('pf-tab-invite');
  if (pfPageTitle) pfPageTitle.textContent = T.profile;
  if (pfSectionTitle) pfSectionTitle.textContent = T.profile;
  if (pfTabAccount) pfTabAccount.textContent = T.pf_account;
  if (pfTabInvite) pfTabInvite.textContent = T.invite_friend;
  const pfLblReg = document.getElementById('pf-lbl-reg-date');
  const pfLblPremium = document.getElementById('pf-lbl-premium');
  const pfPremiumStatus = document.getElementById('pf-premium-status');
  if (pfLblReg) pfLblReg.textContent = T.pf_reg_date;
  if (pfLblPremium) pfLblPremium.textContent = T.pf_premium;
  const pfEmailVal = document.getElementById('pf-val-email');
  if (pfEmailVal) pfEmailVal.textContent = getProfileEmail();
  if (typeof renderReferralUI === 'function') renderReferralUI();

  const pfInviteStat = document.getElementById('pf-invite-stat');
  const pfInviteLinkLbl = document.getElementById('pf-invite-link-lbl');
  const pfInviteProgressLbl = document.getElementById('pf-invite-progress-lbl');
  const pfInviteClaim = document.getElementById('pf-invite-claim');
  const pfInviteFoot = document.getElementById('pf-invite-foot');
  const pfPromoTitle = document.getElementById('pf-promo-title');
  const pfPromoAddBtn = document.getElementById('pf-promo-add-btn');
  const pfPromoInput = document.getElementById('pf-promo-input');
  const pfAdminTitle = document.getElementById('pf-admin-title');
  if (pfInviteStat) {
    const n = document.getElementById('pf-invite-count');
    const cnt = n ? n.textContent : '0';
    pfInviteStat.innerHTML = T.pf_invite_stat + ' <span id="pf-invite-count">' + cnt + '</span>';
  }
  if (pfInviteLinkLbl) pfInviteLinkLbl.textContent = T.pf_invite_link;
  if (pfInviteProgressLbl) pfInviteProgressLbl.textContent = T.pf_invite_progress;
  if (pfInviteClaim) pfInviteClaim.textContent = T.pf_invite_claim;
  if (pfInviteFoot) pfInviteFoot.textContent = T.pf_invite_foot;
  if (pfPromoTitle) pfPromoTitle.textContent = T.pf_promo_title;
  if (pfPromoAddBtn) pfPromoAddBtn.textContent = T.pf_promo_add;
  if (pfPromoInput) pfPromoInput.placeholder = T.pf_promo_ph;
  if (pfAdminTitle) pfAdminTitle.textContent = T.pf_admin_title;
  document.querySelectorAll('#pf-invite-steps .pf-step-txt').forEach((el, i) => {
    el.textContent = (T.pf_invite_step || '{n} of 3').replace('{n}', String(i + 1));
  });

  const pfRegVal = document.getElementById('pf-val-reg-date');
  if (pfRegVal) {
    const raw = pfRegVal.dataset.regTs || '2025-03-16';
    const d = new Date(raw + 'T12:00:00');
    const loc = currentLang === 'es' ? 'es-ES' : 'en-US';
    pfRegVal.textContent = d.toLocaleDateString(loc, { day: 'numeric', month: 'short', year: 'numeric' });
  }

  // html lang attr
  document.documentElement.lang = currentLang;

  // ── Premium section ──────────────────────────────────────────────
  const premDevSpan = document.getElementById('premium-dev-span');
  if (premDevSpan) premDevSpan.textContent = T.section_in_dev;

  // ── Listings tabs ────────────────────────────────────────────────
  const lsPillListings = document.querySelector('#ls-tab-listings .ls-pill-lbl');
  const lsPillDelistings = document.querySelector('#ls-tab-delistings .ls-pill-lbl');
  if (lsPillListings)  lsPillListings.textContent  = T.ls_tab_listings;
  if (lsPillDelistings) lsPillDelistings.textContent = T.ls_tab_delistings;

  // ── Listings hero title + card labels ───────────────────────────
  const lsHeroTitle = document.getElementById('ls-hero-title');
  if (lsHeroTitle) {
    const isDelTab = document.body.classList.contains('ls-tab-delistings') ||
                     (document.getElementById('ls-panel-delistings') &&
                      !document.getElementById('ls-panel-delistings').classList.contains('ls-panel-hidden'));
    lsHeroTitle.textContent = isDelTab ? T.ls_new_delistings : T.ls_new_listings;
  }
  const lsLblTotal = document.getElementById('ls-lbl-total');
  const lsLblDay   = document.getElementById('ls-lbl-day');
  const lsLblWeek  = document.getElementById('ls-lbl-week');
  if (lsLblTotal) lsLblTotal.textContent = T.ls_stat_total;
  if (lsLblDay)   lsLblDay.textContent   = T.ls_stat_day;
  if (lsLblWeek)  lsLblWeek.textContent  = T.ls_stat_week;

  // ── Listings table titles ────────────────────────────────────────
  const lsTitleLbl    = document.getElementById('ls-title-lbl');
  const lsDelTitleLbl = document.getElementById('ls-del-title-lbl');
  if (lsTitleLbl)    lsTitleLbl.textContent    = T.ls_new_listings;
  if (lsDelTitleLbl) lsDelTitleLbl.textContent = T.ls_new_delistings;

  // ── Listings search placeholders ─────────────────────────────────
  const lsSearch    = document.getElementById('ls-search');
  const lsDelSearch = document.getElementById('ls-del-search');
  if (lsSearch)    lsSearch.placeholder    = T.ls_search_ph;
  if (lsDelSearch) lsDelSearch.placeholder = T.ls_search_ph;

  // ── Listings column headers ──────────────────────────────────────
  ['ls-th-ticker1','ls-th-ticker2'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = T.ls_col_ticker; });
  ['ls-th-ex1','ls-th-ex2'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = T.ls_col_exchange; });
  ['ls-th-date1','ls-th-date2'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = T.ls_col_date; });
  const lsThDesc = document.getElementById('ls-th-desc2');
  if (lsThDesc) lsThDesc.textContent = T.ls_col_desc;

  // ── Charts view switcher ─────────────────────────────────────────
  const mvList  = document.getElementById('ch-mview-list');
  const mvChart = document.getElementById('ch-mview-chart');
  if (mvList)  mvList.textContent  = T.ch_view_list;
  if (mvChart) mvChart.textContent = T.ch_view_chart;

  // ── Coin list column headers ─────────────────────────────────────
  document.querySelectorAll('#ch-col-hdr .ch-hdr').forEach(el => {
    switch (el.dataset.sort) {
      case 'sym':  el.textContent = T.ch_hdr_ticker; break;
      case 'vol':  el.textContent = T.ch_hdr_vol24;  break;
      case 'chg':  el.textContent = T.ch_hdr_chg;    break;
      case 'vol5': el.textContent = T.ch_hdr_vol5m;  break;
    }
  });

  // ── Global ticker search modal ───────────────────────────────────
  const gsmTitleEl = document.getElementById('gsm-title');
  if (gsmTitleEl) {
    const cntEl = document.getElementById('gsm-count');
    const cnt = cntEl ? cntEl.textContent : '0';
    gsmTitleEl.innerHTML = T.gsm_title + ' (<span id="gsm-count">' + cnt + '</span>)';
  }
  const gsmEmpty = document.getElementById('gsm-empty');
  if (gsmEmpty && (gsmEmpty.textContent === 'Enter ticker name' || gsmEmpty.textContent === 'Ingresa el ticker')) {
    gsmEmpty.textContent = T.gsm_enter;
  }

  // ── Chart settings modal ─────────────────────────────────────────
  const csCancelBtn   = document.getElementById('ch-cs-cancel');
  const csApplyBtn    = document.getElementById('ch-cs-apply');
  const csApplyAllBtn = document.getElementById('ch-cs-apply-all');
  const csResetBtn    = document.getElementById('ch-cs-reset');
  const csTitleEl     = document.getElementById('ch-cs-title');
  if (csTitleEl)     csTitleEl.textContent     = T.ch_cs_title;
  if (csResetBtn)    csResetBtn.textContent     = T.ch_cs_reset;
  if (csApplyAllBtn) csApplyAllBtn.textContent  = T.ch_cs_apply_all;
  if (csCancelBtn)   csCancelBtn.textContent    = T.ch_cs_cancel;
  if (csApplyBtn)    csApplyBtn.textContent     = T.ch_cs_apply;

  document.querySelectorAll('.ch-cs-tab').forEach(btn => {
    if (btn.dataset.tab === 'instrument') btn.textContent = T.ch_cs_tab_instrument;
    if (btn.dataset.tab === 'appearance') btn.textContent = T.ch_cs_tab_appearance;
  });
  document.querySelectorAll('.ch-cs-section').forEach(el => {
    const txt = el.textContent.trim();
    if (txt === 'Japanese Candles'    || txt === 'Velas Japonesas')           el.textContent = T.ch_cs_candles;
    else if (txt === 'Watermark'      || txt === 'Marca de agua')             el.textContent = T.ch_cs_watermark;
    else if (txt === 'Main Chart Style' || txt === 'Estilo Principal del Gráfico') el.textContent = T.ch_cs_main_style;
  });
  document.querySelectorAll('.ch-cs-row-label').forEach(el => {
    const txt = el.textContent.trim();
    if      (txt === 'Body'      || txt === 'Cuerpo')       el.textContent = T.ch_cs_body;
    else if (txt === 'Border'    || txt === 'Borde')        el.textContent = T.ch_cs_border;
    else if (txt === 'Wick'      || txt === 'Mecha')        el.textContent = T.ch_cs_wick;
    else if (txt === 'Watermark' || txt === 'Marca de agua') el.textContent = T.ch_cs_watermark;
  });
  document.querySelectorAll('#ch-chart-settings-modal label:not(.ch-cs-swatch)').forEach(el => {
    const txt = el.textContent.trim();
    if      (txt === 'Background Color' || txt === 'Color de Fondo') el.textContent = T.ch_cs_bg_color;
    else if (txt === 'Grid'             || txt === 'Cuadrícula')     el.textContent = T.ch_cs_grid;
    else if (txt === 'Text'             || txt === 'Texto')          el.textContent = T.ch_cs_lbl_text;
  });
  const gridSel = document.getElementById('ch-cs-grid-mode');
  if (gridSel) gridSel.querySelectorAll('option').forEach(o => {
    if      (o.value === 'both') o.textContent = T.ch_cs_grid_both;
    else if (o.value === 'vert') o.textContent = T.ch_cs_grid_vert;
    else if (o.value === 'horz') o.textContent = T.ch_cs_grid_horz;
    else if (o.value === 'none') o.textContent = T.ch_cs_grid_none;
  });
}

function toggleLang() {
  currentLang = currentLang === 'en' ? 'es' : 'en';
  localStorage.setItem('crypto_lang', currentLang);
  applyTranslations();
}

function initLangDropdown() {
  const wrap = document.getElementById('sb-lang-wrap');
  const btn  = document.getElementById('sb-lang-btn');
  const menu = document.getElementById('sb-lang-menu');
  if (!wrap || !btn || !menu) return;

  btn.addEventListener('click', e => {
    e.stopPropagation();
    const willOpen = !wrap.classList.contains('open');
    closeAllTopbarDropdowns();
    if (willOpen) {
      wrap.classList.add('open');
      positionFloatMenu(menu, btn);
    }
    updateLangItems();
  });

  menu.querySelectorAll('.sb-lang-item').forEach(item => {
    item.addEventListener('click', e => {
      e.stopPropagation();
      currentLang = item.dataset.lang;
      localStorage.setItem('crypto_lang', currentLang);
      applyTranslations();
      wrap.classList.remove('open');
      resetFloatMenu(menu);
      updateLangItems();
    });
  });

  document.addEventListener('click', () => {
    wrap.classList.remove('open');
    resetFloatMenu(menu);
  });
}

function updateLangItems() {
  document.querySelectorAll('.sb-lang-item[data-lang]').forEach(item => {
    item.classList.toggle('active', item.dataset.lang === currentLang);
  });
}

initLangDropdown();
updateLangItems();

function initProfileDropdown() {
  const wrap = document.getElementById('tb-profile-wrap');
  const btn  = document.getElementById('tb-profile-btn');
  const menu = document.getElementById('tb-profile-menu');
  if (!wrap || !btn || !menu) return;

  btn.addEventListener('click', e => {
    e.stopPropagation();
    const willOpen = !wrap.classList.contains('open');
    closeAllTopbarDropdowns();
    if (willOpen) {
      wrap.classList.add('open');
      positionFloatMenu(menu, btn, { minWidth: 200 });
      menu.style.display = 'flex';
    }
  });

  menu.querySelectorAll('.tb-profile-item').forEach(item => {
    item.addEventListener('click', e => {
      e.stopPropagation();
      if (item.id === 'tb-profile-menu-profile') {
        openProfileTab('account');
      } else if (item.id === 'tb-profile-menu-invite') {
        openProfileTab('invite');
      }
      wrap.classList.remove('open');
      resetFloatMenu(menu);
    });
  });

  document.addEventListener('click', () => {
    wrap.classList.remove('open');
    resetFloatMenu(menu);
  });
}

function getProfileEmail() {
  return (localStorage.getItem('crypto_user_email') || '').trim().toLowerCase();
}

let _referralState = null;

function setProfileTab(tab) {
  const t = tab === 'invite' ? 'invite' : 'account';
  document.querySelectorAll('.pf-tab').forEach(el => {
    el.classList.toggle('active', el.dataset.pfTab === t);
  });
  document.querySelectorAll('.pf-panel').forEach(el => {
    el.classList.toggle('active', el.dataset.pfPanel === t);
  });
  const T = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
  const pfPageTitle = document.getElementById('pf-page-title');
  const pfSectionTitle = document.getElementById('pf-section-title');
  if (t === 'invite') {
    if (pfPageTitle) pfPageTitle.textContent = T.invite_friend;
    loadReferralState();
  } else {
    if (pfPageTitle) pfPageTitle.textContent = T.profile;
    if (pfSectionTitle) pfSectionTitle.textContent = T.profile;
  }
}

function initProfileTabs() {
  document.querySelectorAll('.pf-tab').forEach(btn => {
    btn.addEventListener('click', () => setProfileTab(btn.dataset.pfTab));
  });
  const claimBtn = document.getElementById('pf-invite-claim');
  if (claimBtn) {
    claimBtn.addEventListener('click', async () => {
      if (claimBtn.disabled) return;
      claimBtn.disabled = true;
      try {
        const r = await fetch('/api/referrals/claim-pro', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: getProfileEmail() }),
        });
        const data = await r.json();
        if (!data.ok) throw new Error(data.error || 'claim_failed');
        await loadReferralState();
      } catch (e) {
        console.warn('claim pro', e);
        claimBtn.disabled = false;
      }
    });
  }
  const addBtn = document.getElementById('pf-promo-add-btn');
  const promoInput = document.getElementById('pf-promo-input');
  if (addBtn && promoInput) {
    addBtn.addEventListener('click', () => createUserPromoCode(promoInput.value));
    promoInput.addEventListener('keydown', e => { if (e.key === 'Enter') createUserPromoCode(promoInput.value); });
  }
  const adminBtn = document.getElementById('pf-admin-add-btn');
  if (adminBtn) {
    adminBtn.addEventListener('click', () => {
      const code = document.getElementById('pf-admin-code')?.value || '';
      const pct = parseFloat(document.getElementById('pf-admin-pct')?.value || '10');
      createAdminPromoCode(code, pct);
    });
  }
}

function referralErrorMessage(code) {
  const T = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
  const map = {
    code_taken: T.pf_err_code_taken,
    max_codes: T.pf_err_max_codes,
    invalid_code: T.pf_err_invalid,
  };
  return map[code] || code;
}

async function loadReferralState() {
  const email = getProfileEmail();
  try {
    const r = await fetch('/api/referrals/state?email=' + encodeURIComponent(email));
    _referralState = await r.json();
    if (!_referralState.ok) _referralState = null;
  } catch (e) {
    console.warn('referral state', e);
    _referralState = null;
  }
  renderReferralUI();
  updateProfileAccessLevel();
}

function renderReferralUI() {
  const st = _referralState;
  const T = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
  const countEl = document.getElementById('pf-invite-count');
  const count = st ? (st.referral_count || 0) : 0;
  if (countEl) countEl.textContent = String(count);
  const statEl = document.getElementById('pf-invite-stat');
  if (statEl) statEl.innerHTML = (T.pf_invite_stat || 'Referred users:') + ' <span id="pf-invite-count">' + count + '</span>';

  document.querySelectorAll('#pf-invite-steps .pf-invite-step').forEach((el, i) => {
    el.classList.toggle('done', count > i);
  });

  const claimBtn = document.getElementById('pf-invite-claim');
  if (claimBtn) {
    const can = st && st.can_claim_pro;
    const active = st && st.has_active_pro;
    claimBtn.disabled = !can;
    claimBtn.textContent = T.pf_invite_claim || 'Get PRO';
    if (active) claimBtn.disabled = true;
  }

  const linkEl = document.getElementById('pf-invite-link');
  const codes = (st && st.codes) ? st.codes : [];
  const primary = codes[0]?.code;
  if (linkEl) {
    if (primary) {
      const url = location.origin + '/?promo=' + encodeURIComponent(primary);
      linkEl.href = url;
      linkEl.textContent = url;
    } else {
      linkEl.href = '#';
      linkEl.textContent = '—';
    }
  }

  const list = document.getElementById('pf-promo-list');
  const addRow = document.getElementById('pf-promo-add-row');
  if (list) {
    list.innerHTML = '';
    codes.forEach(c => {
      const tag = document.createElement('div');
      tag.className = 'pf-promo-tag';
      tag.innerHTML = '<span>' + escapeHtml(c.code) + '</span><button type="button" title="×" aria-label="Remove">×</button>';
      tag.querySelector('button').addEventListener('click', () => deletePromoCode(c.code));
      list.appendChild(tag);
    });
  }
  if (addRow) addRow.style.display = codes.length < 3 ? 'flex' : 'none';

  const adminBlock = document.getElementById('pf-admin-block');
  if (adminBlock) adminBlock.classList.toggle('visible', !!(st && st.is_admin));
}

function escapeHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

async function createUserPromoCode(raw) {
  const code = (raw || '').trim();
  if (!code) return;
  const T = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
  try {
    const r = await fetch('/api/referrals/codes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: getProfileEmail(), code }),
    });
    const data = await r.json();
    if (!data.ok) {
      alert(referralErrorMessage(data.error));
      return;
    }
    const inp = document.getElementById('pf-promo-input');
    if (inp) inp.value = '';
    await loadReferralState();
  } catch (e) {
    alert(T.pf_err_invalid);
  }
}

async function createAdminPromoCode(raw, discountPct) {
  const code = (raw || '').trim();
  if (!code) return;
  try {
    const r = await fetch('/api/referrals/admin/codes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: getProfileEmail(), code, discount_pct: discountPct }),
    });
    const data = await r.json();
    if (!data.ok) {
      alert(referralErrorMessage(data.error));
      return;
    }
    document.getElementById('pf-admin-code').value = '';
    await loadReferralState();
  } catch (e) {
    console.warn('admin code', e);
  }
}

async function deletePromoCode(code) {
  try {
    const r = await fetch('/api/referrals/codes/' + encodeURIComponent(code) + '?email=' + encodeURIComponent(getProfileEmail()), { method: 'DELETE' });
    const data = await r.json();
    if (data.ok) await loadReferralState();
  } catch (e) {
    console.warn('delete code', e);
  }
}

function updateProfileAccessLevel() {
  const pill = document.getElementById('pf-premium-status');
  if (!pill) return;
  const T = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
  const active = _referralState && _referralState.has_active_pro;
  if (active) {
    pill.textContent = T.pf_premium_active || 'PRO';
    pill.className = 'pf-pill-good';
  } else {
    pill.textContent = T.pf_premium_inactive;
    pill.className = 'pf-pill-bad';
  }
}

function openProfileTab(tab) {
  switchSection('profile');
  setProfileTab(tab || 'account');
}

initProfileTabs();
initProfileDropdown();
requestAnimationFrame(applyTranslations);

// ══ Theme switcher ════════════════════════════════════════════
let currentTheme = localStorage.getItem('crypto_theme') || 'blue';

function applyTheme(theme) {
  document.body.classList.toggle('theme-blue', theme === 'blue');
  // Update trigger label
  const T = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
  const themeVal = document.getElementById('sb-theme-val');
  if (themeVal) themeVal.textContent = theme === 'blue' ? (T.theme_blue || 'Blue') : (T.theme_green || 'Green');
  // Update checkmarks
  document.querySelectorAll('#sb-theme-menu .sb-lang-item').forEach(item => {
    item.classList.toggle('active', item.dataset.theme === theme);
    const check = item.querySelector('svg');
    if (check) check.style.opacity = item.dataset.theme === theme ? '1' : '0';
  });
}

function initThemeDropdown() {
  const wrap = document.getElementById('sb-theme-wrap');
  const btn  = document.getElementById('sb-theme-btn');
  const menu = document.getElementById('sb-theme-menu');
  if (!wrap || !btn || !menu) return;

  btn.addEventListener('click', e => {
    e.stopPropagation();
    // In collapsed sidebar — toggle theme directly, no dropdown
    if (document.getElementById('app').classList.contains('sb-collapsed')) {
      currentTheme = currentTheme === 'green' ? 'blue' : 'green';
      localStorage.setItem('crypto_theme', currentTheme);
      applyTheme(currentTheme);
      return;
    }
    const willOpen = !wrap.classList.contains('open');
    closeAllTopbarDropdowns();
    if (willOpen) {
      wrap.classList.add('open');
      positionFloatMenu(menu, btn);
    }
  });

  menu.querySelectorAll('.sb-lang-item').forEach(item => {
    item.addEventListener('click', e => {
      e.stopPropagation();
      currentTheme = item.dataset.theme;
      localStorage.setItem('crypto_theme', currentTheme);
      applyTheme(currentTheme);
      wrap.classList.remove('open');
      resetFloatMenu(menu);
    });
  });

  document.addEventListener('click', () => {
    wrap.classList.remove('open');
    resetFloatMenu(menu);
  });
}

initThemeDropdown();
applyTheme(currentTheme);

// ══ Adaptive price font size ══════════════════════════════════
function fitPriceEl(el) {
  el.style.fontSize = '';
  let size = 12;
  while (el.scrollWidth > el.clientWidth + 1 && size > 8.5) {
    size -= 0.5;
    el.style.fontSize = size + 'px';
  }
}
new MutationObserver(mutations => {
  const els = [];
  mutations.forEach(m => m.addedNodes.forEach(node => {
    if (!node || node.nodeType !== 1) return;
    if (node.classList && node.classList.contains('d-price')) els.push(node);
    else node.querySelectorAll && node.querySelectorAll('.d-price').forEach(e => els.push(e));
  }));
  if (els.length) requestAnimationFrame(() => els.forEach(fitPriceEl));
}).observe(document.body, { childList: true, subtree: true });

// ══ Custom tooltip ════════════════════════════════════════════
(function() {
  const box = document.createElement('div');
  box.id = 'tip-box';
  document.body.appendChild(box);
  let hideTimer, showTimer;

  function getTip(el) {
    const key = el.getAttribute('data-tip-key');
    if (key) return t(key);
    return el.getAttribute('data-tip') || '';
  }

  document.addEventListener('mouseover', e => {
    const el = e.target.closest('[data-tip],[data-tip-key]');
    if (!el) return;
    const text = getTip(el);
    if (!text) return;
    clearTimeout(hideTimer);
    clearTimeout(showTimer);
    box.textContent = text;
    showTimer = setTimeout(() => box.classList.add('tip-visible'), 300);
  });

  document.addEventListener('mousemove', e => {
    const x = e.clientX + 14;
    const y = e.clientY - 34;
    box.style.left = x + 'px';
    box.style.top  = y + 'px';
  });

  document.addEventListener('mouseout', e => {
    const el = e.target.closest('[data-tip],[data-tip-key]');
    if (!el) return;
    clearTimeout(showTimer);
    hideTimer = setTimeout(() => box.classList.remove('tip-visible'), 80);
  });

  document.addEventListener('click', () => {
    clearTimeout(showTimer);
    box.classList.remove('tip-visible');
  });
})();
// statsbar switching via CSS #statsbar-density / #statsbar-splash

// ── Watermark auto-fit ────────────────────────────────────────
function _fitWatermark() {
  const wm   = document.getElementById('crypto-watermark');
  const grid = document.getElementById('grid');
  const main = document.getElementById('main');
  if (!wm || !grid || !main) return;
  const r = grid.getBoundingClientRect();
  const w = r.width;
  const mainR = main.getBoundingClientRect();
  if (!w) return;
  // set font-size to fill grid width
  wm.style.fontSize = '200px';
  const scale = w / wm.scrollWidth;
  wm.style.fontSize = Math.floor(200 * scale * 0.97) + 'px';
  // center vertically in viewport within main area
  const cx = r.left + w / 2;
  const cy = mainR.top + mainR.height / 2;
  wm.style.left = cx + 'px';
  wm.style.top  = cy + 'px';
  wm.style.transform = 'translate(-50%,-50%)';
}
window.addEventListener('resize', _fitWatermark);
requestAnimationFrame(_fitWatermark);
new ResizeObserver(_fitWatermark).observe(document.getElementById('main') || document.body);



function _splashMinVolUsd() { return splashMinVol * 1e3; }





function _renderSplashTabs() {
  SPLASH_LABELS.forEach(lbl => _updateColBadge(lbl));
}
function _updateColBadge(lbl) {
  const badge = document.querySelector('.splash-col-badge[data-label="'+lbl+'"]');
  if (!badge) return;
  const on = !!splashActive[lbl];
  badge.className = 'splash-col-badge ' + (on ? 'alert-on' : 'alert-off');
}
function _initColBadgeClicks() {
  document.querySelectorAll('.splash-col-badge').forEach(badge => {
    badge.addEventListener('click', () => {
      const lbl = badge.dataset.label;
      splashActive[lbl] = !splashActive[lbl];
      saveSplashActive();
      _updateColBadge(lbl);
      if (activeSection === 'splash') _renderSplashGrid();
    });
  });
}






function fmtElapsed(sec) {


  if (!sec) return '—';


  if (sec < 60)   return Math.round(sec) + 's';


  if (sec < 3600) return Math.floor(sec/60) + 'm ' + (Math.round(sec)%60) + 's';


  return Math.floor(sec/3600) + 'h ' + Math.floor((sec%3600)/60) + 'm';


}





function fmtSignalTime(ms) {
  const s = new Date(ms).toLocaleTimeString('en-US', {
    hour: 'numeric', minute: '2-digit', hour12: true,
  });
  return s.replace(' AM', ' a.m.').replace(' PM', ' p.m.');
}

const SPLASH_RECENT_MS = 5 * 60 * 1000;
let _splashRecentTimer = null;

function _splashEventMs(ev) {
  if (ev._ts != null) return Number(ev._ts);
  const t = Number(ev.ts);
  if (!Number.isFinite(t) || t <= 0) return Date.now();
  return t < 1e12 ? t * 1000 : t;
}

function _isSplashRecent(ev) {
  return Date.now() - _splashEventMs(ev) < SPLASH_RECENT_MS;
}

function _syncSplashRecentCards() {
  document.querySelectorAll('.splash-card[data-splash-ts]').forEach(card => {
    const ts = Number(card.dataset.splashTs);
    card.classList.toggle('splash-recent', Number.isFinite(ts) && Date.now() - ts < SPLASH_RECENT_MS);
  });
}

function _ensureSplashRecentTimer() {
  if (_splashRecentTimer) return;
  _splashRecentTimer = setInterval(() => {
    if (activeSection === 'splash') _syncSplashRecentCards();
  }, 15000);
}

function _buildSplashCard(ev, isNew) {
  const { base, quote } = symParts(ev.symbol);
  const isUp    = ev.direction === 'up';
  const pctStr  = (isUp?'+':'') + Number(ev.pct).toFixed(2) + '%';
  const exchHtml= (ev.exchanges||[ev.exchange]).map(ex=>`<span class="splash-exch-icon">${exchIcon(ex)}</span>`).join('');
  const card    = document.createElement('div');
  const recent  = _isSplashRecent(ev);
  card.className = 'splash-card ' + (isUp?'up':'down') + (isNew?' new-card':'') + (recent?' splash-recent':'');
  card.dataset.splashTs = String(_splashEventMs(ev));
  const signalAt = fmtSignalTime(_splashEventMs(ev));
  card.innerHTML = `
    <span class="splash-dir">${isUp?'&#9650;':'&#9660;'}</span>
    <div class="splash-sym splash-sym-wrap" data-sym="${ev.symbol}" data-tip-key="tip_copy"><span class="splash-sym-base">${base}</span><span class="splash-sym-quote">${quote}</span></div>
    <span class="splash-pct">${pctStr}</span>
    <div class="splash-meta">
      <span class="splash-time">${signalAt}</span>
      <span class="splash-vol">Vol 24h: ${fmtVol(ev.vol24)}</span>
    </div>
    <div class="splash-exchs">${exchHtml}</div>`;
  card.querySelector('.splash-sym-wrap').addEventListener('click', function() {
    navigator.clipboard.writeText(ev.symbol).catch(()=>{});
    const base = this.querySelector('.splash-sym-base');
    const quote = this.querySelector('.splash-sym-quote');
    if (!base) return;
    const prevText = base.textContent;
    const prevColor = base.style.color;
    base.textContent = '✓ Copied';
    base.style.color = 'var(--accent)';
    if (quote) quote.style.visibility = 'hidden';
    setTimeout(() => {
      base.textContent = prevText;
      base.style.color = prevColor;
      if (quote) quote.style.visibility = '';
    }, 900);
  });
  return card;
}





function _updateSplashTopMover() {
  // Count from full history (never cleared by user), not from visible cards
  const counts = {};
  splashHistory.forEach(sym => { counts[sym] = (counts[sym] || 0) + 1; });
  let topSym = null, topCnt = 0;
  Object.entries(counts).forEach(([sym, cnt]) => { if (cnt > topCnt) { topCnt = cnt; topSym = sym; } });
  const symEl = document.getElementById('splash-top-sym');
  if (symEl) symEl.textContent = topSym || '—';
}

function _splashExchPass(ev) {
  const exchs = ev.exchanges || (ev.exchange ? [ev.exchange] : []);
  return exchs.length === 0 || exchs.some(e => splashExchActive[e] !== false);
}
function _renderSplashGrid() {
  const minUsd = _splashMinVolUsd();
  SPLASH_LABELS.forEach(lbl => {
    const col = document.getElementById('splash-col-' + lbl);
    const cnt = document.getElementById('splash-count-' + lbl);
    if (!col) return;
    const cards = splashCards.filter(ev =>
      ev.label === lbl &&
      (!minUsd || (ev.vol24||0) >= minUsd) &&
      _splashExchPass(ev)
    ).slice(0, SPLASH_COL_MAX);
    col.innerHTML = '';
    cards.forEach(ev => col.appendChild(_buildSplashCard(ev, false)));
    if (cnt) cnt.textContent = cards.length;
    _updateColBadge(lbl);
  });
}





function handleSplashNew(ev) {
  if (ev._ts == null) ev._ts = _splashEventMs(ev);
  splashCards.unshift(ev);
  if (splashCards.length > SPLASH_BUF) splashCards.splice(SPLASH_TRIM);
  saveSplashCards();
  _pushSplashHistory(ev);
  _updateSplashTopMover();
  if (activeSection !== 'splash') return;
  if (!splashActive[ev.label]) return;
  const minUsd = _splashMinVolUsd();
  if (minUsd && (ev.vol24||0) < minUsd) return;
  if (!_splashExchPass(ev)) return;
  const col = document.getElementById('splash-col-' + ev.label);
  const cnt = document.getElementById('splash-count-' + ev.label);
  if (!col) return;
  while (col.children.length >= SPLASH_COL_MAX) col.removeChild(col.lastChild);
  col.insertBefore(_buildSplashCard(ev, true), col.firstChild);
  if (cnt) cnt.textContent = col.children.length;
  _ensureSplashRecentTimer();
}





// min vol input


document.getElementById('splash-minvol-inp').value = splashMinVol;


document.getElementById('splash-minvol-inp').addEventListener('input', function() {


  splashMinVol = parseFloat(this.value) || 0;


  localStorage.setItem(SPLASH_MINVOL_KEY, String(splashMinVol));


  if (activeSection === 'splash') _renderSplashGrid();


});





// Top Mover copy on click
document.getElementById('splash-top-sym').addEventListener('click', function() {
  const sym = this.textContent;
  if (!sym || sym === '—') return;
  navigator.clipboard.writeText(sym).catch(() => {});
  const prev = this.textContent;
  this.textContent = '✓ Copied';
  this.style.color = 'var(--accent)';
  setTimeout(() => { this.textContent = prev; this.style.color = 'var(--accent)'; }, 900);
});

document.getElementById('splash-clear-btn').addEventListener('click', () => {


  splashCards = []; saveSplashCards();


  if (activeSection === 'splash') _renderSplashGrid();


});


document.getElementById('splash-clear-btn').addEventListener('mouseenter', function(){ this.style.borderColor='rgba(204,68,68,0.4)'; this.style.color='var(--ask)'; });


// ══ Spike Settings Panel JS ══════════════════════

// Sound state
const SPLASH_SOUND_ON_KEY   = 'crypto_splash_sound_on';
const SPLASH_SOUND_TYPE_KEY = 'crypto_splash_sound_type';
const SPLASH_SOUND_VOL_KEY  = 'crypto_splash_sound_vol';
let splashSoundOn   = localStorage.getItem(SPLASH_SOUND_ON_KEY) === null ? false : localStorage.getItem(SPLASH_SOUND_ON_KEY) === '1';
let splashSoundType = localStorage.getItem(SPLASH_SOUND_TYPE_KEY) || 'chime';
let splashSoundVol  = parseFloat(localStorage.getItem(SPLASH_SOUND_VOL_KEY) || '30');

let _lastSplashBeep = 0;
function _playSplashSound() {
  if (!splashSoundOn) return;
  const now = Date.now();
  if (now - _lastSplashBeep < 1500) return;
  _lastSplashBeep = now;
  try { _playSound(splashSoundType, Math.max(0.001, splashSoundVol / 100 * 0.35)); } catch(e) {}
}

// Column order (drag) — same idea as charts dock panels
const SPLASH_COL_ORDER_LS = 'crypto_spike_col_order_v1';
const SPLASH_COL_ORDER_DEFAULT = SPLASH_LABELS.slice();

function _applySplashColOrder() {
  const wrap = document.getElementById('splash-cols-wrap');
  if (!wrap) return;
  let order;
  try { order = JSON.parse(localStorage.getItem(SPLASH_COL_ORDER_LS) || 'null'); } catch (e) { order = null; }
  if (!order || !Array.isArray(order) ||
      order.length !== SPLASH_LABELS.length ||
      !SPLASH_LABELS.every(lbl => order.includes(lbl))) {
    order = SPLASH_COL_ORDER_DEFAULT.slice();
  }
  const map = {};
  wrap.querySelectorAll('.splash-col[data-label]').forEach(col => { map[col.dataset.label] = col; });
  order.forEach(lbl => { if (map[lbl]) wrap.appendChild(map[lbl]); });
}

function _saveSplashColOrder() {
  const wrap = document.getElementById('splash-cols-wrap');
  if (!wrap) return;
  const order = [...wrap.querySelectorAll('.splash-col[data-label]')].map(c => c.dataset.label);
  localStorage.setItem(SPLASH_COL_ORDER_LS, JSON.stringify(order));
}

function _spColPanelFromTarget(t) {
  const panel = t.closest('.sp-col-panel[data-label]');
  if (!panel) return null;
  return t.closest('.ch-dock-grab-handle') ? panel : null;
}

function _bindSplashColDrag() {
  const wrap = document.getElementById('splash-cols-wrap');
  if (!wrap || wrap._spColDragBound) return;
  wrap._spColDragBound = true;
  _applySplashColOrder();

  let drag = null;

  function colItems() {
    return [...wrap.children].filter(el =>
      el.classList.contains('sp-col-panel') || el.classList.contains('sp-col-placeholder')
    );
  }

  function movePlaceholder(clientX) {
    if (!drag || !drag.placeholder) return;
    let insertBefore = null;
    for (const item of colItems()) {
      if (item === drag.placeholder || item === drag.panel) continue;
      const r = item.getBoundingClientRect();
      if (clientX < r.left + r.width / 2) { insertBefore = item; break; }
    }
    if (insertBefore) {
      if (drag.placeholder.nextElementSibling !== insertBefore) {
        wrap.insertBefore(drag.placeholder, insertBefore);
      }
    } else if (drag.placeholder !== wrap.lastElementChild) {
      wrap.appendChild(drag.placeholder);
    }
  }

  function beginDrag(e) {
    const panel = drag.panel;
    const rect = panel.getBoundingClientRect();
    drag.started = true;
    drag.placeholder = document.createElement('div');
    drag.placeholder.className = 'sp-col-placeholder';
    drag.placeholder.style.width = rect.width + 'px';
    drag.placeholder.style.flexShrink = '0';
    wrap.insertBefore(drag.placeholder, panel);
    panel.classList.add('sp-col-dragging');
    panel.style.position = 'fixed';
    panel.style.width = rect.width + 'px';
    panel.style.height = rect.height + 'px';
    panel.style.left = rect.left + 'px';
    panel.style.top = rect.top + 'px';
    panel.style.zIndex = '99999';
    panel.style.margin = '0';
    panel.style.flex = 'none';
    document.body.style.userSelect = 'none';
    document.body.style.cursor = 'grabbing';
    _updateDragPos(e);
    movePlaceholder(e.clientX);
  }

  function _updateDragPos(e) {
    if (!drag) return;
    drag.panel.style.left = (e.clientX - drag.offsetX) + 'px';
    drag.panel.style.top = (e.clientY - drag.offsetY) + 'px';
  }

  function endDrag() {
    const panel = drag.panel;
    wrap.insertBefore(panel, drag.placeholder);
    drag.placeholder.remove();
    panel.classList.remove('sp-col-dragging');
    panel.style.position = '';
    panel.style.left = '';
    panel.style.top = '';
    panel.style.width = '';
    panel.style.height = '';
    panel.style.zIndex = '';
    panel.style.margin = '';
    panel.style.flex = '';
    document.body.style.userSelect = '';
    document.body.style.cursor = '';
    _saveSplashColOrder();
    drag = null;
  }

  function onMove(e) {
    if (!drag) return;
    if (!drag.started) {
      const dx = e.clientX - drag.sx;
      const dy = e.clientY - drag.sy;
      if (Math.abs(dx) + Math.abs(dy) < 5) return;
      beginDrag(e);
    }
    _updateDragPos(e);
    movePlaceholder(e.clientX);
  }

  function onUp() {
    if (!drag) return;
    if (drag.started) endDrag();
    drag = null;
    document.removeEventListener('mousemove', onMove);
    document.removeEventListener('mouseup', onUp);
  }

  wrap.addEventListener('mousedown', e => {
    if (e.button !== 0) return;
    const panel = _spColPanelFromTarget(e.target);
    if (!panel) return;
    const rect = panel.getBoundingClientRect();
    drag = {
      panel,
      sx: e.clientX,
      sy: e.clientY,
      started: false,
      offsetX: e.clientX - rect.left,
      offsetY: e.clientY - rect.top,
      placeholder: null,
    };
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  });
}

// Column show/hide
function _renderCols() {
  const labels = SPLASH_LABELS;
  const wrap = document.getElementById('splash-cols-wrap');
  labels.forEach(lbl => {
    const col = document.querySelector('.splash-col[data-label="' + lbl + '"]');
    if (!col) return;
    const on = !!splashActive[lbl];
    col.style.display = on ? '' : 'none';
    if (on) {
      col.style.flex = '1 1 0';
      col.style.minWidth = '200px';
    } else {
      col.style.flex = '';
      col.style.minWidth = '';
    }
  });
}

// Settings panel open/close
(function() {
  const btn = document.getElementById('splash-settings-btn');
  const overlay = document.getElementById('splash-sp-overlay');
  const closeBtn = document.getElementById('ssp-close');
  if (!btn || !overlay) return;

  const panel = document.getElementById('splash-sp-panel');

  function positionPanel() {
    const r = btn.getBoundingClientRect();
    const panelW = 320;
    let left = r.right - panelW;
    if (left < 8) left = 8;
    panel.style.top  = (r.bottom + 14) + 'px';
    panel.style.left = left + 'px';
  }

  btn.addEventListener('click', e => {
    e.stopPropagation();
    const isOpen = overlay.classList.toggle('open');
    if (isOpen) { positionPanel(); _sspSync(); }
  });
  if (closeBtn) closeBtn.addEventListener('click', () => overlay.classList.remove('open'));
  document.addEventListener('click', e => {
    if (!overlay.classList.contains('open')) return;
    if (panel.contains(e.target) || btn.contains(e.target)) return;
    overlay.classList.remove('open');
  });
  window.addEventListener('resize', () => { if (overlay.classList.contains('open')) positionPanel(); });
})();

// Sync panel state to current JS state
function _sspSync() {
  // Thresholds
  const tRow = document.getElementById('ssp-thresh-row');
  if (tRow) {
    tRow.innerHTML = '';
    SPLASH_LABELS.forEach(lbl => {
      const btn = document.createElement('button');
      btn.className = 'ssp-toggle' + (splashActive[lbl] ? ' on' : '');
      btn.textContent = lbl + '%';
      btn.dataset.lbl = lbl;
      btn.addEventListener('click', () => {
        splashActive[lbl] = !splashActive[lbl];
        saveSplashActive();
        btn.classList.toggle('on', !!splashActive[lbl]);
        _renderCols();
        if (activeSection === 'splash') _renderSplashGrid();
      });
      tRow.appendChild(btn);
    });
  }

  // Exchanges
  const eRow = document.getElementById('ssp-exch-row');
  if (eRow) {
    eRow.innerHTML = '';
    SPLASH_EXCHS.forEach(ex => {
      const btn = document.createElement('button');
      btn.className = 'ssp-exch-btn' + (splashExchActive[ex] === false ? ' off' : '');
      btn.title = ex;
      btn.innerHTML = exchIcon(ex);
      btn.addEventListener('click', () => {
        splashExchActive[ex] = splashExchActive[ex] === false ? true : false;
        btn.classList.toggle('off', splashExchActive[ex] === false);
        saveSplashExch();
        if (activeSection === 'splash') _renderSplashGrid();
      });
      eRow.appendChild(btn);
    });
  }

  // Min vol
  const mvInp = document.getElementById('ssp-minvol');
  if (mvInp) {
    mvInp.value = splashMinVol;
    mvInp.addEventListener('change', () => {
      splashMinVol = parseFloat(mvInp.value) || 0;
      localStorage.setItem(SPLASH_MINVOL_KEY, splashMinVol);
      if (activeSection === 'splash') _renderSplashGrid();
    });
  }

  // Sound toggle
  const sndToggle = document.getElementById('ssp-sound-toggle');
  if (sndToggle) {
    sndToggle.textContent = splashSoundOn ? 'On' : 'Off';
    sndToggle.className = 'ssp-toggle' + (splashSoundOn ? ' on' : '');
    sndToggle.onclick = () => {
      splashSoundOn = !splashSoundOn;
      localStorage.setItem(SPLASH_SOUND_ON_KEY, splashSoundOn ? '1' : '0');
      sndToggle.textContent = splashSoundOn ? 'On' : 'Off';
      sndToggle.className = 'ssp-toggle' + (splashSoundOn ? ' on' : '');
      if (splashSoundOn) { _lastSplashBeep = 0; _playSplashSound(); }
    };
  }

  // Sound type buttons
  const sndTypeBtns = document.querySelectorAll('#ssp-sound-types .ssp-sound-btn');
  sndTypeBtns.forEach(btn => {
    btn.classList.toggle('active', btn.dataset.sound === splashSoundType);
    btn.onclick = () => {
      splashSoundType = btn.dataset.sound;
      localStorage.setItem(SPLASH_SOUND_TYPE_KEY, splashSoundType);
      sndTypeBtns.forEach(b => b.classList.toggle('active', b.dataset.sound === splashSoundType));
      _lastSplashBeep = 0; _playSplashSound();
    };
  });

  // Sound volume
  const sndVol = document.getElementById('ssp-sound-vol');
  const sndVolLbl = document.getElementById('ssp-sound-vol-lbl');
  if (sndVol) {
    sndVol.value = splashSoundVol;
    if (sndVolLbl) sndVolLbl.textContent = Math.round(splashSoundVol) + '%';
    sndVol.oninput = () => {
      splashSoundVol = parseFloat(sndVol.value);
      localStorage.setItem(SPLASH_SOUND_VOL_KEY, splashSoundVol);
      if (sndVolLbl) sndVolLbl.textContent = Math.round(splashSoundVol) + '%';
    };
  }
}

// Call renderCols on splash section activation
(function() {
  const origShowSplash = window._showSplashSection;
  // Hook into section switching — patch the section click handler
  document.querySelectorAll('.sb-item[data-section="splash"]').forEach(el => {
    el.addEventListener('click', () => setTimeout(_renderCols, 0));
  });
  // Also call now if splash is active
  if (typeof activeSection !== 'undefined' && activeSection === 'splash') _renderCols();
})();

// Play sound on new splash
(function() {
  const _origHandleSplashNew = handleSplashNew;
  handleSplashNew = function(ev) {
    _origHandleSplashNew(ev);
    _playSplashSound();
  };
})();

// Initial renderCols
_renderCols();

// Exchange filter buttons
(function() {
  const wrap = document.getElementById('splash-exch-btns');
  if (!wrap) return;
  SPLASH_EXCHS.forEach(ex => {
    const btn = document.createElement('button');
    btn.className = 'splash-exch-toggle' + (splashExchActive[ex] === false ? ' off' : '');
    btn.dataset.exch = ex;
    btn.title = ex;
    btn.innerHTML = exchIcon(ex);
    btn.addEventListener('click', () => {
      splashExchActive[ex] = splashExchActive[ex] === false ? true : false;
      btn.classList.toggle('off', splashExchActive[ex] === false);
      saveSplashExch();
      if (activeSection === 'splash') _renderSplashGrid();
    });
    wrap.appendChild(btn);
  });
})();

document.getElementById('splash-clear-btn').addEventListener('mouseleave', function(){ this.style.borderColor='#1e2e1e'; this.style.color='var(--muted2)'; });





_renderSplashTabs();
_initColBadgeClicks();
_applySplashColOrder();
_bindSplashColDrag();





// ══ Arbitrage ════════════════════════════════════════════════
const ARB_EXCHS = SPLASH_EXCHS.slice();
const ARB_EXCH_KEY = 'crypto_arb_exch_v1';
const ARB_MINVOL_KEY = 'crypto_arb_minvol_v1';
const ARB_MINSPREAD_KEY = 'crypto_arb_min_spread_v2';
const ARB_CARDS_KEY = 'crypto_arb_cards_v1';
const ARB_FEED_MAX = SPLASH_COL_MAX;
const ARB_BUF = SPLASH_BUF;
const ARB_TRIM = SPLASH_TRIM;
const ARB_SOUND_ON_KEY = 'crypto_arb_sound_on';
const ARB_SOUND_TYPE_KEY = 'crypto_arb_sound_type';
const ARB_SOUND_VOL_KEY = 'crypto_arb_sound_vol';

function loadArbExch() {
  try { const s = JSON.parse(localStorage.getItem(ARB_EXCH_KEY) || 'null'); if (s) return s; } catch (e) {}
  return Object.fromEntries(ARB_EXCHS.map(e => [e, true]));
}
function saveArbExch() { localStorage.setItem(ARB_EXCH_KEY, JSON.stringify(arbExchActive)); }
let arbExchActive = loadArbExch();
let arbMinVol = parseFloat(localStorage.getItem(ARB_MINVOL_KEY) || '1000') || 1000;
let arbMinSpread = parseFloat(localStorage.getItem(ARB_MINSPREAD_KEY) || '0.5') || 0.5;
let arbSoundOn = localStorage.getItem(ARB_SOUND_ON_KEY) === '1';
let arbSoundType = localStorage.getItem(ARB_SOUND_TYPE_KEY) || 'chime';
let arbSoundVol = parseFloat(localStorage.getItem(ARB_SOUND_VOL_KEY) || '30');
let arbCards = (function() {
  try { return JSON.parse(localStorage.getItem(ARB_CARDS_KEY) || '[]'); } catch (e) { return []; }
})();
function saveArbCards() {
  try { localStorage.setItem(ARB_CARDS_KEY, JSON.stringify(arbCards)); } catch (e) {}
}
let _lastArbBeep = 0;

function _arbMinVolUsd() { return arbMinVol * 1e3; }
function _arbEventMs(ev) {
  if (ev._ts != null) return Number(ev._ts);
  const t = Number(ev.ts);
  if (!Number.isFinite(t) || t <= 0) return Date.now();
  return t < 1e12 ? t * 1000 : t;
}
function _arbExchPass(ev) {
  const cheap = ev.cheap_exchange;
  const rich = ev.expensive_exchange;
  if (arbExchActive[cheap] === false || arbExchActive[rich] === false) return false;
  return true;
}
function _arbPassesFilters(ev) {
  if (ev.market && ev.market !== 'perp') return false;
  const minUsd = _arbMinVolUsd();
  if (minUsd && (ev.vol24 || 0) < minUsd) return false;
  if (ev.pct < arbMinSpread) return false;
  return _arbExchPass(ev);
}
function _sendArbConfig() {
  const ws = window._appWs;
  if (!ws || ws.readyState !== 1) return;
  ws.send(JSON.stringify({
    type: 'arb_config',
    min_spread: arbMinSpread,
    min_vol: arbMinVol,
    exchanges: arbExchActive,
  }));
}
function _playArbSound() {
  if (!arbSoundOn) return;
  const now = Date.now();
  if (now - _lastArbBeep < 1500) return;
  _lastArbBeep = now;
  try { _playSound(arbSoundType, Math.max(0.001, arbSoundVol / 100 * 0.35)); } catch (e) {}
}
function _buildArbCard(ev, isNew) {
  const { base, quote } = symParts(ev.symbol);
  const card = document.createElement('div');
  card.className = 'arb-card' + (isNew ? ' new-card' : '');
  card.dataset.arbTs = String(_arbEventMs(ev));
  const mkt = (ev.market || 'perp').toUpperCase();
  const pctStr = Number(ev.pct).toFixed(2) + '%';
  const signalAt = fmtSignalTime(_arbEventMs(ev));
  card.innerHTML = `
    <div class="arb-sym-row">
      <div class="arb-sym" data-sym="${ev.symbol}"><span class="arb-sym-base">${base}</span><span class="arb-sym-quote">${quote}</span></div>
      <span class="arb-mkt-badge">${mkt}</span>
    </div>
    <div class="arb-leg">
      <span class="arb-leg-lbl">Cheap</span>
      <div class="arb-leg-row">${exchIcon(ev.cheap_exchange)}<span class="arb-leg-ex">${ev.cheap_exchange}</span></div>
      <span class="arb-leg-pr">${fmtPrice(ev.cheap_price)}</span>
    </div>
    <div class="arb-leg">
      <span class="arb-leg-lbl">Expensive</span>
      <div class="arb-leg-row">${exchIcon(ev.expensive_exchange)}<span class="arb-leg-ex">${ev.expensive_exchange}</span></div>
      <span class="arb-leg-pr">${fmtPrice(ev.expensive_price)}</span>
    </div>
    <div class="arb-spread-col">
      <div class="arb-spread-pct">${pctStr}</div>
      <div class="arb-meta">${signalAt} · Vol ${fmtVol(ev.vol24 || 0)}</div>
    </div>`;
  const symEl = card.querySelector('.arb-sym');
  if (symEl) {
    symEl.addEventListener('click', () => {
      navigator.clipboard.writeText(ev.symbol).catch(() => {});
    });
  }
  return card;
}
function _renderArbFeed() {
  const feed = document.getElementById('arb-feed');
  if (!feed) return;
  const list = arbCards.filter(_arbPassesFilters).slice(0, ARB_FEED_MAX);
  feed.innerHTML = '';
  list.forEach(ev => feed.appendChild(_buildArbCard(ev, false)));
}
function handleArbNew(ev) {
  if (ev._ts == null) ev._ts = _arbEventMs(ev);
  arbCards.unshift(ev);
  if (arbCards.length > ARB_BUF) arbCards.splice(ARB_TRIM);
  saveArbCards();
  if (!_arbPassesFilters(ev)) return;
  _playArbSound();
  if (activeSection !== 'arbitrage') return;
  const feed = document.getElementById('arb-feed');
  if (!feed) return;
  while (feed.children.length >= ARB_FEED_MAX) feed.removeChild(feed.lastChild);
  feed.insertBefore(_buildArbCard(ev, true), feed.firstChild);
}
(function() {
  const btn = document.getElementById('arb-settings-btn');
  const overlay = document.getElementById('arb-sp-overlay');
  const closeBtn = document.getElementById('arb-sp-close');
  const panel = document.getElementById('arb-sp-panel');
  if (!btn || !overlay || !panel) return;
  function positionPanel() {
    const r = btn.getBoundingClientRect();
    const panelW = 320;
    let left = r.right - panelW;
    if (left < 8) left = 8;
    panel.style.top = (r.bottom + 14) + 'px';
    panel.style.left = left + 'px';
  }
  function syncPanel() {
    const eRow = document.getElementById('arb-sp-exch-row');
    if (eRow && !eRow.dataset.bound) {
      eRow.dataset.bound = '1';
      eRow.innerHTML = '';
      ARB_EXCHS.forEach(ex => {
        const b = document.createElement('button');
        b.className = 'ssp-exch-btn' + (arbExchActive[ex] === false ? ' off' : '');
        b.title = ex;
        b.innerHTML = exchIcon(ex);
        b.addEventListener('click', () => {
          arbExchActive[ex] = arbExchActive[ex] === false ? true : false;
          b.classList.toggle('off', arbExchActive[ex] === false);
          saveArbExch();
          _sendArbConfig();
          if (activeSection === 'arbitrage') _renderArbFeed();
        });
        eRow.appendChild(b);
      });
    }
    const ms = document.getElementById('arb-sp-minspread');
    if (ms && !ms.dataset.bound) {
      ms.dataset.bound = '1';
      ms.value = arbMinSpread;
      ms.addEventListener('change', () => {
        arbMinSpread = Math.max(0.5, parseFloat(ms.value) || 0.5);
        localStorage.setItem(ARB_MINSPREAD_KEY, String(arbMinSpread));
        _sendArbConfig();
        if (activeSection === 'arbitrage') _renderArbFeed();
      });
    }
    const mv = document.getElementById('arb-sp-minvol');
    if (mv && !mv.dataset.bound) {
      mv.dataset.bound = '1';
      mv.value = arbMinVol;
      mv.addEventListener('change', () => {
        arbMinVol = parseFloat(mv.value) || 0;
        localStorage.setItem(ARB_MINVOL_KEY, String(arbMinVol));
        _sendArbConfig();
        if (activeSection === 'arbitrage') _renderArbFeed();
      });
    }
    const sndToggle = document.getElementById('arb-sp-sound-toggle');
    if (sndToggle && !sndToggle.dataset.bound) {
      sndToggle.dataset.bound = '1';
      sndToggle.textContent = arbSoundOn ? 'On' : 'Off';
      sndToggle.className = 'ssp-toggle' + (arbSoundOn ? ' on' : '');
      sndToggle.onclick = () => {
        arbSoundOn = !arbSoundOn;
        localStorage.setItem(ARB_SOUND_ON_KEY, arbSoundOn ? '1' : '0');
        sndToggle.textContent = arbSoundOn ? 'On' : 'Off';
        sndToggle.className = 'ssp-toggle' + (arbSoundOn ? ' on' : '');
        if (arbSoundOn) { _lastArbBeep = 0; _playArbSound(); }
      };
    }
    document.querySelectorAll('#arb-sp-sound-types .ssp-sound-btn').forEach(btn2 => {
      if (btn2.dataset.bound) return;
      btn2.dataset.bound = '1';
      btn2.classList.toggle('active', btn2.dataset.sound === arbSoundType);
      btn2.onclick = () => {
        arbSoundType = btn2.dataset.sound;
        localStorage.setItem(ARB_SOUND_TYPE_KEY, arbSoundType);
        document.querySelectorAll('#arb-sp-sound-types .ssp-sound-btn').forEach(b =>
          b.classList.toggle('active', b.dataset.sound === arbSoundType));
        _lastArbBeep = 0; _playArbSound();
      };
    });
    const sndVol = document.getElementById('arb-sp-sound-vol');
    const sndVolLbl = document.getElementById('arb-sp-sound-vol-lbl');
    if (sndVol && !sndVol.dataset.bound) {
      sndVol.dataset.bound = '1';
      sndVol.value = arbSoundVol;
      if (sndVolLbl) sndVolLbl.textContent = Math.round(arbSoundVol) + '%';
      sndVol.oninput = () => {
        arbSoundVol = parseFloat(sndVol.value);
        localStorage.setItem(ARB_SOUND_VOL_KEY, String(arbSoundVol));
        if (sndVolLbl) sndVolLbl.textContent = Math.round(arbSoundVol) + '%';
      };
    }
  }
  btn.addEventListener('click', e => {
    e.stopPropagation();
    const isOpen = overlay.classList.toggle('open');
    if (isOpen) { positionPanel(); syncPanel(); }
  });
  if (closeBtn) closeBtn.addEventListener('click', () => overlay.classList.remove('open'));
  document.addEventListener('click', e => {
    if (!overlay.classList.contains('open')) return;
    if (panel.contains(e.target) || btn.contains(e.target)) return;
    overlay.classList.remove('open');
  });
  window.addEventListener('resize', () => { if (overlay.classList.contains('open')) positionPanel(); });
})();
const arbClearBtn = document.getElementById('arb-clear-btn');
if (arbClearBtn) {
  arbClearBtn.addEventListener('click', () => {
    arbCards = [];
    saveArbCards();
    const feed = document.getElementById('arb-feed');
    if (feed) feed.innerHTML = '';
  });
}

// ── Section navigation ───────────────────────────────────────


function switchSection(section) {
  activeSection = section;
  localStorage.setItem('crypto_section', section);
  ['charts','screener','densities','splash','arbitrage','premium','listings','profile'].forEach(s => {
    document.body.classList.toggle('sec-' + s, section === s);
  });
  if (section === 'arbitrage') {
    _sendArbConfig();
    _renderArbFeed();
  }
  if (section === 'splash') {
    _applySplashColOrder();
    _renderSplashTabs();
    _renderSplashGrid();
    _renderCols();
    _updateSplashTopMover();
    _ensureSplashRecentTimer();
    _syncSplashRecentCards();
  }
  if (section === 'charts' || section === 'screener') { if (window._initCharts) window._initCharts(); }
  if (section === 'listings') { if (window._initListings) window._initListings(); }
  if (section === 'profile') {
    if (typeof loadReferralState === 'function') loadReferralState();
  }
  requestAnimationFrame(() => window._syncChHeaderSearchPos?.());
}



document.querySelectorAll('#top-nav .sb-nav-item').forEach((el) => {
  el.addEventListener('click', () => {
    const map = {
      'nav-charts': 'charts',
      'nav-screener': 'screener',
      'nav-densities': 'densities',
      'nav-splash': 'splash',
      'nav-arbitrage': 'arbitrage',
      'nav-premium': 'premium',
      'nav-listings': 'listings',
    };
    const section = map[el.id];
    if (section) switchSection(section);
  });
});

/* ── Mobile burger navigation ──────────────────────────────────
   The drawer items proxy clicks to the existing #top-nav items,
   so all section-switching logic stays in one place. */
(function initMobileNav() {
  const toggle  = document.getElementById('mobile-nav-toggle');
  const overlay = document.getElementById('mobile-nav-overlay');
  const drawer  = document.getElementById('mobile-nav-drawer');
  if (!toggle || !drawer || !overlay) return;
  const items = drawer.querySelectorAll('.mobile-nav-item');

  // #brandbar has its own stacking context (z-index:9200), which would trap the
  // drawer/overlay below section overlays like #charts-main (z-index:9500) no
  // matter how high their own z-index is. Re-parent them to <body> so their
  // z-index resolves against the document root.
  if (overlay.parentElement !== document.body) document.body.appendChild(overlay);
  if (drawer.parentElement !== document.body) document.body.appendChild(drawer);

  function syncActive() {
    items.forEach((it) => {
      it.classList.toggle('active', document.body.classList.contains('sec-' + it.dataset.sec));
    });
  }
  function open()  { document.body.classList.add('mnav-open');    toggle.setAttribute('aria-expanded', 'true');  drawer.setAttribute('aria-hidden', 'false'); syncActive(); }
  function close() { document.body.classList.remove('mnav-open'); toggle.setAttribute('aria-expanded', 'false'); drawer.setAttribute('aria-hidden', 'true'); }

  toggle.addEventListener('click', () => {
    document.body.classList.contains('mnav-open') ? close() : open();
  });
  overlay.addEventListener('click', close);
  const closeBtn = document.getElementById('mobile-nav-close');
  if (closeBtn) closeBtn.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  items.forEach((it) => {
    it.addEventListener('click', () => {
      const target = document.getElementById(it.dataset.nav);
      if (target) target.click();
      close();
    });
  });
})();

/* ── Mobile Charts view switcher (Список / График) ───────────── */
(function initChMobileView() {
  const bar = document.getElementById('ch-mview');
  if (!bar) return;
  function setView(v) {
    const chart = v === 'chart';
    document.body.classList.toggle('ch-mv-chart', chart);
    document.body.classList.toggle('ch-mv-list', !chart);
    try { localStorage.setItem('crypto_ch_mview', chart ? 'chart' : 'list'); } catch (e) {}
    if (chart) {
      // the chart panel was display:none — once visible, nudge a resize so
      // the lightweight-chart picks up its real dimensions.
      requestAnimationFrame(() => { try { window.dispatchEvent(new Event('resize')); } catch (e) {} });
    }
  }
  bar.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => setView(b.dataset.mv)));
  let saved = null;
  try { saved = localStorage.getItem('crypto_ch_mview'); } catch (e) {}
  setView(saved === 'chart' ? 'chart' : 'list');
})();

/* ── Drawing-tools pencil toggle ──────────────────────────────
   Mobile: ephemeral dropdown (default closed, opens on tap, closes on outside/tool click).
   Desktop: tools open by default; pencil collapses/expands them; state persisted in localStorage. */
(function initChDrawDropdown() {
  const toggle = document.getElementById('ch-draw-toggle');
  const bar = document.getElementById('ch-draw-bar');
  const barStart = document.getElementById('ch-bar-start');
  if (!toggle || !bar || !barStart) return;
  const DRAW_LS = 'crypto_ch_draw_collapsed';
  const isMobile = () => window.matchMedia('(max-width: 768px)').matches;
  function setMobileOpen(open) {
    barStart.classList.toggle('draw-open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  // Desktop initial aria state (collapse class already applied by the early head script from localStorage)
  toggle.setAttribute('aria-expanded', document.body.classList.contains('ch-draw-collapsed') ? 'false' : 'true');
  toggle.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isMobile()) {
      setMobileOpen(!barStart.classList.contains('draw-open'));
    } else {
      const collapsed = document.body.classList.toggle('ch-draw-collapsed');
      try { localStorage.setItem(DRAW_LS, collapsed ? '1' : '0'); } catch (err) {}
      toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    }
  });
  document.addEventListener('click', (e) => {
    if (!isMobile() || !barStart.classList.contains('draw-open')) return;
    if (e.target === toggle || toggle.contains(e.target) || bar.contains(e.target)) return;
    setMobileOpen(false);
  });
  bar.querySelectorAll('.ch-draw-btn').forEach((b) => b.addEventListener('click', () => {
    if (isMobile()) setMobileOpen(false);
  }));
})();











