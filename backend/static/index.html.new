    <div class="sp-body">





      <!-- ── LEFT COLUMN ── -->


      <div class="sp-left">





        <!-- Sort + Direction -->


        <div class="sp-section">


          <div class="sp-section-title">Sort</div>


          <div class="sort-row2">


            <select class="sp-select" id="sp-sort-select" style="flex:1">


              <option value="time">By Time</option>


              <option value="volume">By Volume</option>


              <option value="distance">By Distance</option>




            </select>


            <button class="sort-dir-btn on" id="sort-order-btn">↓</button>


          </div>


        </div>





        <!-- Distance % -->


        <div class="sp-section">


          <div class="sp-section-title">Distance %</div>


          <select class="sp-select" id="sp-distance-select" style="width:100%">


            <option value="0">Any (no limit)</option>


            <option value="0.5">0.5%</option>


            <option value="1">1%</option>


            <option value="2">2%</option>


            <option value="3">3%</option>


            <option value="5">5%</option>


            <option value="10">10%</option>


          </select>


        </div>





        <!-- Wall Age -->


        <div class="sp-section">


          <div class="sp-section-title">Wall Age</div>


          <div class="sp-time-row">


            <span class="sp-time-label">From</span>


            <input class="sp-time-val" id="sp-time-from-val" type="number" placeholder="—" min="0">


            <select class="sp-select sp-time-unit" id="sp-time-from-unit">


              <option value="seconds">seconds</option>


              <option value="minutes" selected>minutes</option>


              <option value="hours">hours</option>


              <option value="days">days</option>


            </select>


            <span class="sp-time-label">To</span>


            <input class="sp-time-val" id="sp-time-to-val" type="number" placeholder="—" min="0">


            <select class="sp-select sp-time-unit" id="sp-time-to-unit">


              <option value="seconds">seconds</option>


              <option value="minutes" selected>minutes</option>


              <option value="hours">hours</option>


              <option value="days">days</option>


            </select>


          </div>


        </div>





        <!-- Min size per exchange -->


        <div class="sp-section">


          <div class="sp-section-title">Min Size (S / F)</div>


          <div id="sp-exch-rows"></div>


        </div>





        <!-- Card Style -->


        <div class="sp-section">


          <div class="sp-section-title">Card Style</div>


          <div id="sp-card-style"></div>


        </div>





        <!-- Coin list -->


        <div class="sp-section">


          <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px">


            <div class="sp-section-title" style="margin-bottom:0;flex-shrink:0">Coin List</div>


            <div class="coin-list-search-wrap">


              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>


              <input id="coin-list-search" type="text" placeholder="Search…" autocomplete="off" spellcheck="false">


            </div>


            <button class="sp-add-coin-btn" id="sp-add-coin" style="width:auto;padding:5px 12px;font-size:12px;border-radius:7px;flex-shrink:0">


              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>


              Add Coin


            </button>


          </div>


          <div id="coin-list"></div>


          <button class="sp-add-coin-btn" id="sp-add-coin-bottom">


            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>


            Add Coin


          </button>


        </div>





      </div><!-- /sp-left -->





      <!-- ── RIGHT COLUMN ── -->


      <div class="sp-right">


        <div class="sp-section">


          <div class="sp-section-title">Exchanges</div>


          <div id="sp-exch-selection"></div>


        </div>


        <div class="sp-section">


          <div class="sp-section-title">Sound</div>


          <div class="sp-sound-types" id="sp-sound-types">


            <button class="sp-sound-btn" id="sp-sound-off-btn" data-sound="off">Off</button>


            <button class="sp-sound-btn active" data-sound="chime">Chime</button>


            <button class="sp-sound-btn" data-sound="bell">Bell</button>


            <button class="sp-sound-btn" data-sound="drop">Drop</button>


            <button class="sp-sound-btn" data-sound="pulse">Pulse</button>




          </div>


          <div class="sp-vol-row">


            <span class="sp-vol-icon">


              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>


            </span>


            <input type="range" id="sp-sound-vol" class="sp-vol-slider" min="0" max="100" value="20">


            <span class="sp-vol-label" id="sp-vol-label">20%</span>


          </div>


        </div>


        <div class="sp-section">


          <div class="sp-section-title">Quote Currencies</div>


          <div class="sp-quotes-grid" id="sp-quotes-grid"></div>


        </div>


        <div class="sp-section">


          <div class="sp-section-title">Mode</div>


          <div class="sp-mode-row">


            <button class="sp-mode-btn" id="sp-mode-hide-rwa-btn" style="flex:0 0 64px;" title="Hide tokenized stocks, ETFs, metals &amp; commodities">RWA</button>


            <button class="sp-mode-btn" id="sp-mode-all-btn">Crypto</button>


          </div>

          <div class="sp-mode-row" style="margin-top:6px;">


            <button class="sp-mode-btn" id="sp-mode-binance-btn">Only Binance Perp Crypto</button>


          </div>


        </div>


      </div><!-- /sp-right -->





    </div><!-- /sp-body -->





    <div class="sp-footer">


      <button class="sp-reset-link" id="sp-reset">


        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.86"/></svg>


        Reset Settings


      </button>


      <div class="sp-footer-spacer"></div>


      <button class="sp-cancel-btn" id="sp-cancel">Cancel</button>


      <button class="sp-save-btn"   id="sp-save">Save</button>


    </div>


  </div>


</div>


<div id="sp-unsaved-overlay">


  <div id="sp-unsaved-box">


    <button id="sp-unsaved-dismiss" data-tip-key="tip_continue">✕</button>


    <p><strong>Unsaved changes.</strong><br>Are you sure you want to exit?</p>


    <div class="sp-unsaved-btns">


      <button id="sp-unsaved-exit">Exit</button>


      <button id="sp-unsaved-save">Save</button>


    </div>


  </div>


</div>







<script>


// ══ Workspace bootstrap (must run before loadSettings) ════════


const WS_MAX = 5;


let workspaces = JSON.parse(localStorage.getItem('crypto_workspaces') || '["Workspace 1"]');


let wsActive   = Math.min(parseInt(localStorage.getItem('crypto_ws_active') || '0'), workspaces.length - 1);


function wsSettingsKey(i) { return 'crypto_ws_v3_' + i; }

// Returns translated name if it is a default "Workspace N" name, otherwise original
function wsDisplayName(name) {
  if (!/^Workspace \d+$/.test(name)) return name;
  const num = name.replace('Workspace ', '');
  try { return t('ws_prefix') + ' ' + num; } catch(e) { return name; }
}


function wsModeKey(i)     { return 'crypto_ws_mode_' + i; }





// One-time migration: copy legacy crypto_v3 → workspace 0 slot


(function() {


  const legacy = localStorage.getItem('crypto_v3');


  if (legacy && !localStorage.getItem(wsSettingsKey(0))) {


    localStorage.setItem(wsSettingsKey(0), legacy);


  }


})();





// ══ Exchange favicon helper ═══════════════════════════════════


function _faveErr(img, abbr, color, fs) {


  img.style.display = 'none';


  const s = document.createElement('span');


  s.textContent = abbr;


  s.style.cssText = `font-size:${fs}px;font-weight:900;color:${color};line-height:1`;


  img.parentNode.insertBefore(s, img.nextSibling);


}





// ══ Config ═══════════════════════════════════════════════════


const DEFAULT_CARD_STYLE = {


  tiers: [


    { id:'low',   label:'Low',   fromThresh: 50000,   bidColor: '', askColor: '' },


    { id:'mid',   label:'Mid',   fromThresh: 500000,  bidColor: '', askColor: '' },


    { id:'large', label:'Large', fromThresh: 2000000, bidColor: '', askColor: '' },


  ]


};





const ALL_QUOTES = ['USDT','USDC','USDE','USD'];


const DEFAULT_QUOTES_ENABLED = Object.fromEntries(ALL_QUOTES.map(q => [q, q === 'USDT']));





const EXCHANGES_LIST = [
  { key:'binance',     label:'Binance',     abbr:'BN', domain:'binance.com',       color:'#F0B90B' },
  { key:'bybit',       label:'Bybit',       abbr:'BY', domain:'bybit.com',         color:'#FF6108' },
  { key:'okx',         label:'OKX',         abbr:'OK', domain:'okx.com',           color:'#5B8EFF' },
  { key:'gate',        label:'Gate.io',     abbr:'GT', domain:'gate.io',           color:'#5BB4FF' },
  { key:'bitget',      label:'Bitget',      abbr:'BG', domain:'bitget.com',        color:'#1DA2B4' },
  { key:'mexc',        label:'MEXC',        abbr:'MX', domain:'mexc.com',          color:'#2354E6' },
  { key:'bingx',       label:'BingX',       abbr:'BX', domain:'bingx.com',         color:'#00C5E3' },
  { key:'kucoin',      label:'KuCoin',      abbr:'KC', domain:'kucoin.com',        color:'#00DA8B' },
  { key:'bitunix',     label:'Bitunix',     abbr:'BU', domain:'bitunix.com',       color:'#6A50F8' },
  { key:'bitmart',     label:'BitMart',     abbr:'BM', domain:'bitmart.com',       color:'#1EE0AC' },
  { key:'hyperliquid', label:'Hyperliquid', abbr:'HL', domain:'hyperliquid.xyz',   color:'#50FA7B' },
  { key:'aster',       label:'Aster',       abbr:'AS', domain:'asterdex.com',      color:'#FF6B2B' },
];

const EXCH_DOMAINS = {
  binance:'binance.com', bybit:'bybit.com', okx:'okx.com', gate:'gate.io', bitget:'bitget.com',
  mexc:'mexc.com', bingx:'bingx.com', kucoin:'kucoin.com', bitunix:'bitunix.com',
  bitmart:'bitmart.com', hyperliquid:'hyperliquid.xyz', aster:'asterdex.com',
};


const DEFAULT_EXCH_MINS = {


  binance:{s:50000,f:50000}, bybit:{s:50000,f:50000}, okx:{s:50000,f:50000},


  gate:{s:50000,f:50000}, bitget:{s:50000,f:50000}


};


const DEFAULT_SYM_OVERRIDES = {


  BTCUSDT:5000000, ETHUSDT:3000000, BNBUSDT:2000000, BCHUSDT:2000000,


  HYPEUSDT:2000000, DOGEUSDT:2000000, ZECUSDT:1000000,


  AVAXUSDT:500000, TONUSDT:500000, TRXUSDT:500000, NEARUSDT:500000,


  '1000PEPEUSDT':500000, PEPEUSDT:500000,


  TAOUSDT:300000, PENGUUSDT:200000, ORDIUSDT:200000, ATOMUSDT:200000, XMRUSDT:200000,


  SOLUSDT:500000, XRPUSDT:150000, XLMUSDT:150000,


  SEIUSDT:200000, ETCUSDT:100000, LINKUSDT:200000, AAVEUSDT:200000,


  SUIUSDT:200000, FILUSDT:120000, HBARUSDT:100000,


  APTUSDT:100000, ASTERUSDT:100000,


};


const DEFAULT_COIN_LIST = Object.entries(DEFAULT_SYM_OVERRIDES)


  .filter(([s]) => s !== 'PEPEUSDT') // PEPEUSDT covered by 1000PEPEUSDT entry


  .map(([symbol, minVol]) => ({symbol, minVol, visible:true, mkt_s:true, mkt_f:true}))


  .concat([{symbol:'PEPEUSDT', minVol:500000, visible:true, mkt_s:true, mkt_f:true}]);





// ══ Settings ══════════════════════════════════════════════════


const DEFAULT_EXCH_ENABLED = {


  binance:{s:true,f:true}, bybit:{s:true,f:true}, okx:{s:true,f:true},


  gate:{s:true,f:true}, bitget:{s:true,f:true}


};


const DEFAULT_TIME_OBJ = () => ({ value: '', unit: 'minutes' });


function defaultSettings() {


  return {


    sortBy:'time', sortOrder:'desc', distancePct:'10',


    timeFrom: DEFAULT_TIME_OBJ(), timeTo: DEFAULT_TIME_OBJ(),


    soundOn: false, soundVolume: 20, soundType: 'chime',


    exchangeMins: JSON.parse(JSON.stringify(DEFAULT_EXCH_MINS)),


    exchangeEnabled: JSON.parse(JSON.stringify(DEFAULT_EXCH_ENABLED)),


    quotesEnabled: JSON.parse(JSON.stringify(DEFAULT_QUOTES_ENABLED)),


    cardStyle: JSON.parse(JSON.stringify(DEFAULT_CARD_STYLE)),


    coinList: JSON.parse(JSON.stringify(DEFAULT_COIN_LIST))


  };


}


function loadSettings(idx) {


  idx = idx != null ? idx : wsActive;


  try {


    const r = JSON.parse(localStorage.getItem(wsSettingsKey(idx)) || 'null');


    if (r && r.exchangeMins) {


      // migrate older saves


      if (!r.exchangeEnabled) r.exchangeEnabled = JSON.parse(JSON.stringify(DEFAULT_EXCH_ENABLED));


      if (!r.distancePct) r.distancePct = '10';


      if (!r.timeFrom || typeof r.timeFrom === 'string') r.timeFrom = DEFAULT_TIME_OBJ();


      if (!r.timeTo   || typeof r.timeTo   === 'string') r.timeTo   = DEFAULT_TIME_OBJ();


      if (r.soundOn == null || !r._v2)  r.soundOn = false;  // v2: sound off by default


      r._v2 = true;


      if (r.soundVolume == null) r.soundVolume = 20;


      if (!r.soundType)          r.soundType   = 'chime';


      if (!r.quotesEnabled) r.quotesEnabled = JSON.parse(JSON.stringify(DEFAULT_QUOTES_ENABLED));


      // Fix: if ALL quotes are disabled (corrupt state), reset to default


      if (r.quotesEnabled && Object.values(r.quotesEnabled).every(v => v === false))


        r.quotesEnabled = JSON.parse(JSON.stringify(DEFAULT_QUOTES_ENABLED));


      // Always ensure USDT is enabled


      if (r.quotesEnabled) r.quotesEnabled['USDT'] = true;


      if (!r.cardStyle) r.cardStyle = JSON.parse(JSON.stringify(DEFAULT_CARD_STYLE));


      if (!r.coinList || r.coinList.length === 0) r.coinList = JSON.parse(JSON.stringify(DEFAULT_COIN_LIST));


      // migrate old thresh → fromThresh


      if (r.cardStyle && r.cardStyle.tiers) {


        r.cardStyle.tiers.forEach(t => {


          if (t.thresh != null && t.fromThresh == null) { t.fromThresh = t.thresh; delete t.thresh; }


        });


      }


      delete r.name;


      return r;


    }


  } catch(e) {}


  return defaultSettings();


}


let settings     = loadSettings();


let draftSettings = null;


function saveSettings(idx) {


  idx = idx != null ? idx : wsActive;


  localStorage.setItem(wsSettingsKey(idx), JSON.stringify(settings));


}





// ══ Quick-filter state ════════════════════════════════════════


let filterExchange = 'all', filterMarket = 'all', filterSide = 'all', filterText = '';


let favsOnly = false;


let screenerMode = 'all'; // session-only, not persisted (binance_only requires Binance connected)

// ── RWA base tickers (tokenized stocks, ETFs, metals, commodities) ────────
// Variants are matched by normalization: AMDON→AMD, AMDX→AMD, TQQQ→QQQ
const RWA_BASES = new Set([
  // US Stocks
  'AAPL','AMD','AMZN','ARM','AVGO','BABA','COIN','CRCL','GOOGL',
  'HOOD','INTC','META','MRVL','MSFT','MSTR','MU','NFLX','NVDA',
  'ORCL','PLTR','PREOPAI','RKLB','SNDK','TSLA','TSM','UBER',
  // ETFs & Leveraged ETFs
  'EWY','IAU','ITOT','IVV','IWM','QQQ','SLV','SOXL','SPY',
  'SPXL','TQQQ','TECL','UPRO',
  // Metals & Commodities
  'BZ','CL','COPPER','NATGAS','XAU','XPD','XPT',
  // Misc
  'MCDX','PRESPAX',
  // added 2026-06-07
  'TW88','VOLX','BMNR','QNT','ASML','SNOW','EWT','HD','ANTHROPIC',
  'HYUNDAI','XCU','USO','QNTX','SKHYNIX','LLY','LEO','DELL','BRKB',
  'SPACEX','US2000','XAL','BVIX','LITE','FUTUON','ANDURIL','DIS','CRWD',
  'NOKSTOCK',
  // added 2026-06-07 batch 2
  'EWJ','SPCX','IBM','NBIS','AAOI','SPX500','NAS100','DRAM','CRWV',
  'XAG','BTCDOM',
  // added 2026-06-07 batch 3
  'ABBV','JPN225','WDC','JDON','ALICE','IEFA','AMDSTOCK',
]);

function isRwa(symbol) {
  if (!symbol.endsWith('USDT')) return false;
  const base = symbol.slice(0, -4); // strip USDT
  if (RWA_BASES.has(base)) return true;
  // AMDONUSDT → AMDON → strip ON → AMD
  if (base.endsWith('ON') && RWA_BASES.has(base.slice(0, -2))) return true;
  // AMDXUSDT → AMDX → strip X → AMD
  if (base.endsWith('X') && base.length > 2 && RWA_BASES.has(base.slice(0, -1))) return true;
  // TQQQUSDT → TQQQ → strip T prefix → QQQ (leveraged versions)
  if (base.startsWith('T') && base.length > 2 && RWA_BASES.has(base.slice(1))) return true;
  return false;
}

let hideRwa = true;





// ══ Core state ════════════════════════════════════════════════


const densities   = new Map();


const symCards    = new Map();  // symbol -> Set of density ids


let favorites     = new Set(JSON.parse(localStorage.getItem('crypto_favs') || '[]'));


let soundOn       = settings.soundOn !== false;


let soundVolume   = settings.soundVolume ?? 20;


let soundType     = settings.soundType || 'beep';


let audioCtx      = null;


let _lastBeep     = 0;  // throttle: ms of last beep





// ══ Filter logic ══════════════════════════════════════════════


const UNIT_SECS = { seconds: 1, minutes: 60, hours: 3600, days: 86400 };


function passesFilter(d) {


  if (screenerMode === 'binance_only' && !d.binance_f) return false;

  if (hideRwa && isRwa(d.symbol)) return false;


  const { quote: _q } = symParts(d.symbol.toUpperCase());


  const _qKey = _q.slice(1);


  if (_qKey && (settings.quotesEnabled || DEFAULT_QUOTES_ENABLED)[_qKey] !== true) return false;


  if (filterExchange !== 'all' && d.exchange !== filterExchange) return false;


  if (filterMarket   !== 'all' && d.market   !== filterMarket)   return false;


  if (filterSide     !== 'all' && d.side     !== filterSide)     return false;


  if (filterText && !d.symbol.toLowerCase().includes(filterText.toLowerCase())) return false;


  if (favsOnly && !favorites.has(d.symbol)) return false;


  const mk = d.market === 'spot' ? 's' : 'f';


  const ee = (settings.exchangeEnabled||{})[d.exchange];


  if (ee && ee[mk] === false) return false;


  const sym = d.symbol.toUpperCase();


  const coin = (settings.coinList || []).find(c => c.symbol === sym);


  if (coin && coin.visible === false) return false;


  const maxDist = parseFloat(settings.distancePct);


  if (!isNaN(maxDist) && maxDist > 0 && Math.abs(d.pct_from_price) > maxDist) return false;


  const ageSec = Date.now() / 1000 - d.first_seen;


  const tf = settings.timeFrom, tt = settings.timeTo;


  if (tf && tf.value !== '' && tf.value !== null) { const fs=parseFloat(tf.value)*(UNIT_SECS[tf.unit]||60); if(!isNaN(fs)&&ageSec<fs) return false; }


  if (tt && tt.value !== '' && tt.value !== null) { const ts=parseFloat(tt.value)*(UNIT_SECS[tt.unit]||60); if(!isNaN(ts)&&ageSec>ts) return false; }


  const emin = ((settings.exchangeMins||{})[d.exchange]||{})[mk]||0;


  const coinMin = (coin&&coin.minVol!=null)?coin.minVol:(DEFAULT_SYM_OVERRIDES[sym]&&mk==='f')?DEFAULT_SYM_OVERRIDES[sym]:0;


  return d.volume_usd >= Math.max(coinMin, emin);


}





// ══ Formatters ════════════════════════════════════════════════


function fmtUsd(v) {


  if (v >= 1e9) return (v/1e9).toFixed(2)+'B$';


  if (v >= 1e6) return (v/1e6).toFixed(2)+'M$';


  if (v >= 1e3) return (v/1e3).toFixed(1)+'K$';


  return v.toFixed(0)+'$';


}


function fmtVol(v) {


  if (!v || v <= 0) return '—';


  if (v >= 1e9) return +(v/1e9).toFixed(2) + 'b';


  if (v >= 1e6) return +(v/1e6).toFixed(1) + 'm';


  if (v >= 1e3) return Math.round(v/1e3) + 'k';


  return Math.round(v) + '';


}


function fmtPrice(p) {


  if (p >= 10000) return p.toLocaleString('en-US',{maximumFractionDigits:1});


  if (p >= 100)   return p.toLocaleString('en-US',{maximumFractionDigits:2});


  if (p >= 1)     return p.toLocaleString('en-US',{maximumFractionDigits:4});


  if (p >= 0.01)  return p.toLocaleString('en-US',{maximumFractionDigits:5});


  return p.toFixed(6);


}


function fmtAge(ts) {


  const s = Math.floor(Date.now()/1000 - ts);


  if (s < 60)   return s+'s';


  if (s < 3600) return Math.floor(s/60)+'m ' + (s%60)+'s';


  return Math.floor(s/3600)+'h';


}


function exchIcon(ex) {


  const obj = EXCHANGES_LIST.find(e => e.key === ex);


  if (!obj) return `<span style="font-size:10px;font-weight:900;color:#777">${ex.slice(0,2).toUpperCase()}</span>`;


  return `<img src="https://www.google.com/s2/favicons?domain=${obj.domain}&sz=32" width="17" height="17" alt="${obj.abbr}" title="${ex}" style="border-radius:2px;display:block" onerror="_faveErr(this,'${obj.abbr}','${obj.color}',10)">`;


}


function symParts(sym) {


  const QUOTES = ['FDUSD','USDT','USDC','USDE','BUSD','TUSD','USD','EUR','GBP','TRY','BRL','AUD','BTC','ETH','BNB'];


  for (const q of QUOTES) {


    if (sym.endsWith(q)) return { base: sym.slice(0, -q.length), quote: '/' + q };


  }


  return { base: sym, quote: '' };


}


function saveFavs() { localStorage.setItem('crypto_favs', JSON.stringify([...favorites])); }





// ══ Sound ═════════════════════════════════════════════════════


function _ensureAudio() {


  if (!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)();


  if (audioCtx.state === 'suspended') audioCtx.resume();


  return audioCtx;


}





function _playSound(type, vol) {


  const ctx = _ensureAudio();


  const t = ctx.currentTime;


  const g = ctx.createGain();


  g.connect(ctx.destination);





  if (type === 'beep') {


    // Falling tone 900→450 Hz


    const osc = ctx.createOscillator();


    osc.connect(g); osc.type = 'sine';


    osc.frequency.setValueAtTime(900, t);


    osc.frequency.exponentialRampToValueAtTime(450, t+0.15);


    g.gain.setValueAtTime(vol, t);


    g.gain.exponentialRampToValueAtTime(0.001, t+0.32);


    osc.start(t); osc.stop(t+0.32);





  } else if (type === 'ping') {


    // Short clean high sine 1400 Hz


    const osc = ctx.createOscillator();


    osc.connect(g); osc.type = 'sine';


    osc.frequency.setValueAtTime(1400, t);


    g.gain.setValueAtTime(vol, t);


    g.gain.exponentialRampToValueAtTime(0.001, t+0.25);


    osc.start(t); osc.stop(t+0.25);





  } else if (type === 'chime') {


    // Two-note ascending: 600 then 900 Hz


    [0, 0.14].forEach((delay, i) => {


      const osc = ctx.createOscillator();


      const gn  = ctx.createGain();


      osc.connect(gn); gn.connect(ctx.destination);


      osc.type = 'sine';


      osc.frequency.setValueAtTime(i === 0 ? 600 : 900, t+delay);


      gn.gain.setValueAtTime(vol * 0.8, t+delay);


      gn.gain.exponentialRampToValueAtTime(0.001, t+delay+0.28);


      osc.start(t+delay); osc.stop(t+delay+0.28);


    });





  } else if (type === 'click') {


    // Percussive noise burst


    const buf = ctx.createBuffer(1, ctx.sampleRate * 0.05, ctx.sampleRate);


    const data = buf.getChannelData(0);


    for (let i = 0; i < data.length; i++) data[i] = (Math.random()*2-1) * (1 - i/data.length);


    const src = ctx.createBufferSource();


    src.buffer = buf;


    src.connect(g);


    g.gain.setValueAtTime(vol * 1.5, t);


    g.gain.exponentialRampToValueAtTime(0.001, t+0.05);


    src.start(t);





  } else if (type === 'blip') {


    // Quick up-down chirp 500→1000→500 Hz


    const osc = ctx.createOscillator();


    osc.connect(g); osc.type = 'square';


    const flt = ctx.createBiquadFilter();


    flt.type = 'lowpass'; flt.frequency.value = 1800;


    osc.connect(flt); flt.connect(g);


    osc.frequency.setValueAtTime(500, t);


    osc.frequency.exponentialRampToValueAtTime(1000, t+0.08);


    osc.frequency.exponentialRampToValueAtTime(500, t+0.16);


    g.gain.setValueAtTime(vol * 0.4, t);


    g.gain.exponentialRampToValueAtTime(0.001, t+0.18);


    osc.start(t); osc.stop(t+0.18);





  } else if (type === 'bell') {


    // Deep resonant bell — 220 Hz triangle, long tail


    const osc = ctx.createOscillator();


    const osc2 = ctx.createOscillator();


    const g2 = ctx.createGain();


    osc.connect(g); osc2.connect(g2); g2.connect(ctx.destination);


    osc.type = 'triangle'; osc.frequency.value = 220;


    osc2.type = 'triangle'; osc2.frequency.value = 440;


    g.gain.setValueAtTime(vol * 0.9, t);


    g.gain.exponentialRampToValueAtTime(0.001, t + 1.4);


    g2.gain.setValueAtTime(vol * 0.3, t);


    g2.gain.exponentialRampToValueAtTime(0.001, t + 0.7);


    osc.start(t); osc.stop(t + 1.4);


    osc2.start(t); osc2.stop(t + 0.7);





  } else if (type === 'drop') {


    // Low descending tone 380→140 Hz — deep thud feel


    const osc = ctx.createOscillator();


    osc.connect(g); osc.type = 'sine';


    osc.frequency.setValueAtTime(380, t);


    osc.frequency.exponentialRampToValueAtTime(140, t + 0.35);


    g.gain.setValueAtTime(vol * 1.1, t);


    g.gain.exponentialRampToValueAtTime(0.001, t + 0.4);


    osc.start(t); osc.stop(t + 0.4);





  } else if (type === 'pulse') {


    // Three soft low pulses: 260 → 330 → 410 Hz


    [[0, 260], [0.18, 330], [0.36, 410]].forEach(([delay, freq]) => {


      const osc = ctx.createOscillator();


      const gn  = ctx.createGain();


      osc.connect(gn); gn.connect(ctx.destination);


      osc.type = 'sine'; osc.frequency.value = freq;


      gn.gain.setValueAtTime(vol * 0.7, t + delay);


      gn.gain.exponentialRampToValueAtTime(0.001, t + delay + 0.22);


      osc.start(t + delay); osc.stop(t + delay + 0.22);


    });


  }


}





function playBeep(force) {


  if (!soundOn) return;


  const now = Date.now();


  if (!force && now - _lastBeep < 1500) return;  // throttle: max 1 beep per 1.5s


  _lastBeep = now;


  try { _playSound(soundType, Math.max(0.001, soundVolume / 100 * 0.35)); } catch(e) {}


}





// ══ Card style helpers ════════════════════════════════════════


// Brighten a hex color by blending with white for readable text


function _textOnBg(hex) {


  // All palette colors are dark → use bright text


  return 'rgba(255,255,255,0.92)';


}


function getRowBg(d) {


  const cs = settings.cardStyle || DEFAULT_CARD_STYLE;


  const tiers = [...(cs.tiers || DEFAULT_CARD_STYLE.tiers)];


  // Sort largest fromThresh first — assign tier to highest matching threshold


  tiers.sort((a, b) => (b.fromThresh || 0) - (a.fromThresh || 0));


  const vol = d.volume_usd;


  for (const tier of tiers) {


    if (vol >= (tier.fromThresh || 0)) {


      const color = d.side === 'bid' ? tier.bidColor : tier.askColor;


      return color || '';


    }


  }


  return '';


}


function _hexToRgb(hex) {
  hex = hex.replace('#','');
  if (hex.length === 3) hex = hex.split('').map(c=>c+c).join('');
  const n = parseInt(hex,16);
  return [(n>>16)&255,(n>>8)&255,n&255];
}

function applyRowBg(el, d) {
  const bg = getRowBg(d);
  const volEl = el.querySelector('.d-vol');
  if (!volEl) return;

  if (bg) {
    const [r,g,b] = _hexToRgb(bg);
    volEl.style.background = `linear-gradient(135deg, rgba(${r},${g},${b},0.28) 0%, rgba(${r},${g},${b},0.08) 100%)`;
    volEl.style.border = `1px solid rgba(${r},${g},${b},0.18)`;
    volEl.style.color = _textOnBg(bg);
    volEl.style.borderRadius = '3px';
    el.style.background = `linear-gradient(to right, rgba(${r},${g},${b},0.10) 0%, transparent 75%)`;
  } else {
    volEl.style.background = '';
    volEl.style.border = '';
    volEl.style.color = '';
    el.style.background = '';
  }
}





// ══ Update debounce buffer ════════════════════════════════════


const _updateBuf = new Map(); // id -> density data


const _rowEls    = new Map(); // id -> DOM row element (cache to avoid querySelector)


let _updateRaf = null;


function _flushUpdates() {


  _updateRaf = null;


  _updateBuf.forEach((d, id) => _applyUpdate(d));


  _updateBuf.clear();


}


function _scheduleFlush() {


  if (!_updateRaf) _updateRaf = requestAnimationFrame(_flushUpdates);


}





// ══ Row builder ═══════════════════════════════════════════════


function buildRow(d, isNew=false) {


  const el   = document.createElement('div');


  el.className = `d-row ${d.side}${isNew?' new-row':''}`;


  el.dataset.id = d.id;


  const mktKey = d.market === 'spot' ? 's' : 'f';


  const mktTxt = d.market === 'spot' ? 'S' : 'F';


  el.innerHTML = `


    <span class="d-vol">${fmtUsd(d.volume_usd)}</span>


    <span class="d-exch">${exchIcon(d.exchange)}</span>


    <span class="d-mkt-lbl ${mktKey}">${mktTxt}</span>


    <span class="d-age" data-ts="${d.first_seen}">${fmtAge(d.first_seen)}</span>


    <span class="d-price">${fmtPrice(d.price)}</span>


    <span class="d-pct">${Math.abs(d.pct_from_price).toFixed(1)}%</span>


  `;


  applyRowBg(el, d);


  el._pctEl = el.querySelector('.d-pct');


  el._volEl = el.querySelector('.d-vol');


  el._ageEl = el.querySelector('.d-age');


  _rowEls.set(d.id, el);


  return el;


}





// ══ Card builder ══════════════════════════════════════════════


function getOrCreateCard(symbol) {


  let card = document.getElementById('card-' + symbol);


  if (card) return card;





  const { base, quote } = symParts(symbol);


  card = document.createElement('div');


  card.id        = 'card-' + symbol;


  card.className = 'card card-new' + (favorites.has(symbol) ? ' fav' : '');


  setTimeout(() => card.classList.remove('card-new'), 300);





  card.innerHTML = `


    <div class="card-header">


      <span class="card-sym" data-tip-key="tip_copy" style="cursor:pointer">${base}</span>


      <span class="card-quote">${quote}</span>


      <div class="card-spacer"></div>


      <button class="card-icon-btn card-eye-btn" data-tip-key="tip_hide_coin" data-sym="${symbol}">


        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>


      </button>


      <button class="card-icon-btn fav-btn${favorites.has(symbol)?' active':''}" data-tip-key="tip_favorite" data-sym="${symbol}">☆</button>


      <button class="card-gear-btn" data-tip-key="tip_settings" data-sym="${symbol}">


        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>


      </button>


    </div>


  `;





  // detect market type from first density (assigned later) — placeholder header badge updated on first row insert


  card.querySelector('.card-sym').addEventListener('click', e => {


    e.stopPropagation();


    navigator.clipboard.writeText(symbol).catch(() => {});


    const el = e.currentTarget;


    const prev = el.textContent;


    el.style.color = 'var(--accent)';


    el.textContent = '✓ Copied';


    setTimeout(() => { el.textContent = prev; el.style.color = ''; }, 900);


  });


  card.querySelector('.fav-btn').addEventListener('click', e => { e.stopPropagation(); toggleFav(symbol); });


  card.querySelector('.card-eye-btn').addEventListener('click', e => { e.stopPropagation(); hideSymbolViaSettings(symbol); });


  card.querySelector('.card-gear-btn').addEventListener('click', e => { e.stopPropagation(); openSettingsForSymbol(symbol); });





  if (!symCards.has(symbol)) symCards.set(symbol, new Set());


  document.getElementById('grid').appendChild(card);


  return card;


}





function updateCardMarketBadge(card, d) {


  if (card.querySelector('.card-market')) return;


  const hdr = card.querySelector('.card-header');


  const badge = document.createElement('span');


  badge.className = `card-market market-${d.market === 'spot' ? 's' : 'f'}`;


  badge.textContent = d.market === 'spot' ? 'S' : 'F';


  // insert after card-quote


  const quoteEl = hdr.querySelector('.card-quote');


  quoteEl.after(badge);


}





function renderCard(symbol) {


  const card = document.getElementById('card-' + symbol);


  if (!card) return;


  const ids = symCards.get(symbol);


  if (!ids) return;





  card.querySelectorAll('.d-row').forEach(el => { _rowEls.delete(el.dataset.id); el.remove(); });


  const ds = [...ids].map(id => densities.get(id)).filter(d => d && passesFilter(d));


  ds.sort(sortDensities);


  ds.forEach(d => card.appendChild(buildRow(d)));





  if (ids.size === 0) { removeCard(symbol); return; }


  card.style.display = ds.length === 0 ? 'none' : '';


}





// Rows within a card are ALWAYS sorted by distance from price, side-aware:


//   Asks (red)  at TOP,    largest distance first  → 3%, 2%, 1%


//   Bids (green) at BOTTOM, smallest distance first → 1%, 2%, 3%


// This mirrors the order book: closest orders in the middle, farthest at edges.


function sortDensities(a, b) {


  if (a.side !== b.side) return a.side === 'ask' ? -1 : 1;  // asks before bids


  if (a.side === 'ask') {


    // asks: descending by distance (farthest first)


    return Math.abs(b.pct_from_price) - Math.abs(a.pct_from_price);


  } else {


    // bids: ascending by distance (closest first)


    return Math.abs(a.pct_from_price) - Math.abs(b.pct_from_price);


  }


}





function removeCard(symbol) {


  document.getElementById('card-'+symbol)?.remove();


  symCards.delete(symbol);


}





function toggleFav(symbol) {


  if (favorites.has(symbol)) favorites.delete(symbol); else favorites.add(symbol);


  saveFavs();


  const card = document.getElementById('card-'+symbol);


  if (card) {


    card.classList.toggle('fav', favorites.has(symbol));


    const btn = card.querySelector('.fav-btn');


    if (btn) {


      btn.classList.toggle('active', favorites.has(symbol));


      btn.textContent = favorites.has(symbol) ? '★' : '☆';


    }


  }


  reorderGrid();


}





function cardSortVal(sym) {


  const ids = symCards.get(sym);


  if (!ids || !ids.size) return 0;


  const ds = [...ids].map(id => densities.get(id)).filter(Boolean);


  if (!ds.length) return 0;


  const desc = settings.sortOrder === 'desc';


  switch (settings.sortBy) {


    case 'volume':


      // desc = highest volume first, asc = lowest volume first


      return desc ? Math.max(...ds.map(d => d.volume_usd))


                  : -Math.max(...ds.map(d => d.volume_usd));


    case 'distance':


      // desc = farthest wall first, asc = closest wall first


      return desc ? Math.min(...ds.map(d => Math.abs(d.pct_from_price)))


                  : -Math.min(...ds.map(d => Math.abs(d.pct_from_price)));


    case 'age':


      // asc = newest card first (card with most recently added density comes first)


      // desc = oldest card first (card where the oldest density is oldest comes first)


      return desc ? -Math.min(...ds.map(d => d.first_seen))


                  :  Math.max(...ds.map(d => d.first_seen));


    default: // time


      // desc = most recently added card first, asc = oldest card first


      return desc ?  Math.max(...ds.map(d => d.first_seen))


                  : -Math.max(...ds.map(d => d.first_seen));


  }


}





let _reorderRaf = null;



function reorderGrid() {


  if (_reorderRaf) return;


  _reorderRaf = requestAnimationFrame(_doReorderGrid);


}


function _doReorderGrid() {


  _reorderRaf = null;


  const grid  = document.getElementById('grid');

  const cards = [...grid.querySelectorAll('.card')];





  // FLIP – First: snapshot positions


  const first = new Map();


  cards.forEach(c => {


    const r = c.getBoundingClientRect();


    first.set(c.id, { top: r.top, left: r.left });


  });





  // Sort (Last state)


  cards.sort((a, b) => {


    const sA = a.id.replace('card-',''), sB = b.id.replace('card-','');


    const fa = favorites.has(sA)?1:0, fb = favorites.has(sB)?1:0;


    if (fa !== fb) return fb - fa;


    return cardSortVal(sB) - cardSortVal(sA);


  });


  // Strip new-row before DOM move to prevent animation restart (Chrome restarts CSS
  // animations when a node is re-inserted, which would flash green on blue theme)
  cards.forEach(c => c.querySelectorAll('.d-row.new-row').forEach(r => r.classList.remove('new-row')));


  cards.forEach(c => grid.appendChild(c));





  // FLIP – Invert + Play


  requestAnimationFrame(() => {


    cards.forEach(c => {


      const f = first.get(c.id);


      if (!f) return;


      const l = c.getBoundingClientRect();


      const dy = f.top  - l.top;


      const dx = f.left - l.left;


      if (Math.abs(dy) < 0.5 && Math.abs(dx) < 0.5) return;


      c.style.transition = 'none';


      c.style.transform  = `translate(${dx}px,${dy}px)`;


      requestAnimationFrame(() => {


        c.style.transition = 'transform .32s cubic-bezier(0.4,0,0.2,1)';


        c.style.transform  = '';


      });


    });


  });


}





function updateStats() {


  let total=0, perp=0, spot=0;


  densities.forEach(d => { if (passesFilter(d)) { total++; if (d.market==='perp') perp++; else spot++; } });


  const syms = new Set();


  densities.forEach(d => { if (passesFilter(d)) syms.add(d.symbol); });


  document.getElementById('stat-total').textContent = total;


  document.getElementById('stat-perp').textContent  = perp;


  document.getElementById('stat-spot').textContent  = spot;


  document.getElementById('stat-syms').textContent  = syms.size;


}





// ══ WS handlers ═══════════════════════════════════════════════


function handleNew(d) {


  if (!d.first_seen) d.first_seen = Date.now() / 1000;  // fallback if server didn't send timestamp


  densities.set(d.id, d);


  if (!symCards.has(d.symbol)) symCards.set(d.symbol, new Set());


  symCards.get(d.symbol).add(d.id);


  if (!passesFilter(d)) { updateStats(); return; }





  const emptyEl = document.getElementById('empty');


  if (emptyEl) emptyEl.remove();





  const card = getOrCreateCard(d.symbol);


  updateCardMarketBadge(card, d);


  card.style.display = '';


  card.classList.add('flash');


  setTimeout(() => card.classList.remove('flash'), 750);





  const row = buildRow(d, true);


  // Insert at the correct sorted position (respects current sortBy / sortOrder)


  const anchor = [...card.querySelectorAll('.d-row')].find(el => {


    const other = densities.get(el.dataset.id);


    return other && sortDensities(d, other) < 0;


  });


  if (anchor) card.insertBefore(row, anchor); else card.appendChild(row);


  playBeep(); reorderGrid(); updateStats();


}





function handleRestore(d) {


  // Wall reappeared after brief disconnect — restore silently, no animation, no sound, keep first_seen


  densities.set(d.id, d);


  if (!symCards.has(d.symbol)) symCards.set(d.symbol, new Set());


  symCards.get(d.symbol).add(d.id);


  if (!passesFilter(d)) { updateStats(); return; }


  const emptyEl = document.getElementById('empty');


  if (emptyEl) emptyEl.remove();


  const card = getOrCreateCard(d.symbol);


  updateCardMarketBadge(card, d);


  card.style.display = '';


  // No flash, no beep — just insert at correct sorted position


  const row = buildRow(d, false);


  const anchor = [...card.querySelectorAll('.d-row')].find(el => {


    const other = densities.get(el.dataset.id);


    return other && sortDensities(d, other) < 0;


  });


  if (anchor) card.insertBefore(row, anchor); else card.appendChild(row);


  reorderGrid(); updateStats();


}





function handleUpdate(d) {


  densities.set(d.id, d);


  _updateBuf.set(d.id, d);


  _scheduleFlush();


}


function _applyUpdate(d) {


  const row = _rowEls.get(d.id);


  const passes = passesFilter(d);


  if (!row && !passes) return; // not visible and won't become visible — skip





  if (row) {


    if (passes) {


      // Still passes — update values in place


      row.querySelector('.d-vol').textContent   = fmtUsd(d.volume_usd);


      row.querySelector('.d-price').textContent = fmtPrice(d.price);


      row.querySelector('.d-pct').textContent   = Math.abs(d.pct_from_price).toFixed(1) + '%';


      row.querySelector('.d-age').textContent   = fmtAge(d.first_seen);


      applyRowBg(row, d);


    } else {


      // No longer passes filter (e.g. pct_from_price moved outside distance limit) — hide row


      row.remove(); _rowEls.delete(d.id);


      const card = document.getElementById('card-' + d.symbol);


      if (card && !card.querySelector('.d-row')) card.style.display = 'none';


    }


  } else if (passes) {


    // Was previously hidden by filter but now passes again — insert row into card


    const card = getOrCreateCard(d.symbol);


    const newRow = buildRow(d);


    const existingRows = [...card.querySelectorAll('.d-row')];


    const insertBefore = existingRows.find(r => {


      const rd = densities.get(r.dataset.id);


      return rd && sortDensities(d, rd) < 0;


    });


    if (insertBefore) card.insertBefore(newRow, insertBefore);


    else card.appendChild(newRow);


    card.style.display = '';


  }


  updateStats();


}





function handleRemove(id) {


  const d = densities.get(id);


  if (!d) return;


  densities.delete(id);


  const ids = symCards.get(d.symbol);


  if (ids) {


    ids.delete(id);


    if (ids.size === 0) removeCard(d.symbol);


    else renderCard(d.symbol);


  }


  const _el = _rowEls.get(id); if (_el) { _el.remove(); _rowEls.delete(id); }


  updateStats();


}





function handleInitial(list) {


  densities.clear(); symCards.clear(); _rowEls.clear();


  document.getElementById('grid').innerHTML = '';


  if (!list.length) {


    document.getElementById('grid').innerHTML =


      '<div id="empty">No densities yet<span>Data is loading from exchanges…</span></div>';


    return;


  }


  list.sort((a,b) => b.first_seen - a.first_seen);


  list.forEach(d => {


    densities.set(d.id, d);


    if (!symCards.has(d.symbol)) symCards.set(d.symbol, new Set());


    symCards.get(d.symbol).add(d.id);


  });


  [...symCards.keys()].forEach(sym => { getOrCreateCard(sym); renderCard(sym); });


  // update market badges


  densities.forEach(d => {


    const card = document.getElementById('card-'+d.symbol);


    if (card) updateCardMarketBadge(card, d);


  });


  reorderGrid(); updateStats();


}





// ══ Age ticker ════════════════════════════════════════════════


setInterval(() => {


  _rowEls.forEach((row) => {


    const ageEl = row._ageEl;


    if (ageEl) ageEl.textContent = fmtAge(parseFloat(ageEl.dataset.ts));


  });


}, 1000);





// ══ WebSocket ═════════════════════════════════════════════════


let _wsChartsEverOpen = false;

function connect() {


  const proto = location.protocol==='https:'?'wss':'ws';


  const ws = new WebSocket(`${proto}://${location.host}/ws`);
  window._appWs = ws;   // expose globally so charts IIFE can send chart_sub


  ws.onopen = () => {


    document.getElementById('conn-dot').className = 'on';


    document.getElementById('conn-label').textContent = 'Connected';


    ws._ping = setInterval(() => { if (ws.readyState===1) ws.send('ping'); }, 30000);

    if (_wsChartsEverOpen && document.body.classList.contains('sec-charts') && window._chResubscribeCharts) {
      window._chResubscribeCharts();
    }
    _wsChartsEverOpen = true;
    _sendArbConfig();

    setTimeout(() => {
      if (densities.size > 0) return;
      fetch('/api/densities')
        .then(r => r.ok ? r.json() : [])
        .then(list => { if (Array.isArray(list) && list.length) handleInitial(list); })
        .catch(() => {});
    }, 1200);


  };


  ws.onmessage = ev => {


    if (ev.data==='pong') return;


    try {


      const msg = JSON.parse(ev.data);


      if      (msg.type==='initial_state')        handleInitial(msg.data);


      else if (msg.type==='density_new')          handleNew(msg.data);


      else if (msg.type==='density_new_batch')    msg.data.forEach(d => handleNew(d));


      else if (msg.type==='density_update')       handleUpdate(msg.data);


      else if (msg.type==='density_update_batch') msg.data.forEach(d => handleUpdate(d));


      else if (msg.type==='density_remove')        handleRemove(msg.data.id);


      else if (msg.type==='density_remove_batch')  msg.data.forEach(id => handleRemove(id));


      else if (msg.type==='density_restore')        handleRestore(msg.data);


      else if (msg.type==='density_pct_batch') {


        msg.data.forEach(p => {


          const d = densities.get(p.id);


          if (!d) return;


          d.pct_from_price = p.pct;


          if (p.vol !== undefined) d.volume_usd = p.vol;


          const row = _rowEls.get(p.id);


          if (row) {


            if (row._pctEl) row._pctEl.textContent = Math.abs(p.pct).toFixed(1) + '%';


            if (p.vol !== undefined && row._volEl) row._volEl.textContent = fmtUsd(p.vol);


          }


        });


      }


      else if (msg.type === 'splash_new') {
        msg.data.forEach(ev => handleSplashNew(ev));
        // Server-side Top Mover (shared across all users, not cleared by user)
        if (msg.top_mover) {
          const symEl = document.getElementById('splash-top-sym');
          if (symEl) symEl.textContent = msg.top_mover;
        }
      }

      else if (msg.type === 'arb_new') {
        msg.data.forEach(ev => handleArbNew(ev));
      }


      else if (msg.type === 'market_data' && msg.pairs) {
        // Cache market_data for Charts coin list
        window._chMarketData = msg.pairs.map(p => ({ sym: p.s, vol: p.v, chg: p.c, price: p.p }));
        if (document.body.classList.contains('sec-charts') && window._chRefreshCoins) {
          window._chRefreshCoins();
          if (window._chPrefetchTop) window._chPrefetchTop();
        }
      }

      else if (msg.type === 'klines_data' && window._chKlinesData) {
        window._chKlinesData(msg);
      }

      else if (msg.type === 'klines_error' && window._chKlinesError) {
        window._chKlinesError(msg);
      }

      else if (msg.type === 'klines_full' && window._chKlinesFull) {
        window._chKlinesFull(msg);
      }

      else if (msg.type === 'price_changes') {
        if (window._chHandlePriceChanges) window._chHandlePriceChanges(msg.data);
      }

      else if (msg.type === 'kline_update' && window._chKlineUpdate) {
        window._chKlineUpdate(msg);
      }

      else if (msg.type === 'klines_tick' && window._chKlineUpdate) {
        // 1-sec active-coin tick: reuse kline_update handler with adapted shape
        window._chKlineUpdate({
          exchange: msg.exchange, symbol: msg.symbol, tf: msg.tf,
          candle: msg.candle,
        });
      }

      else if (msg.type === 'ticker_update' && window._chTickerUpdate) {
        window._chTickerUpdate(msg);
      }


    } catch(e) {}


  };


  ws.onclose = () => {


    clearInterval(ws._ping);


    document.getElementById('conn-dot').className = '';


    document.getElementById('conn-label').textContent = 'Reconnecting…';


    setTimeout(connect, 3000);


  };


  ws.onerror = () => ws.close();


}











// ══ Quick-filters ═════════════════════════════════════════════


function applyFilters() {


  [...symCards.keys()].forEach(sym => renderCard(sym));


  reorderGrid(); updateStats();


}





// ── Custom filterbar dropdowns ────────────────────────────────


(function() {


  const DDEFS = [


    { id: 'exchange', varSetter: v => { filterExchange = v; },


      labels: { all:'All', binance:'Binance', bybit:'Bybit', okx:'OKX', gate:'Gate.io', bitget:'Bitget' } },


    { id: 'market',   varSetter: v => { filterMarket = v; },


      labels: { all:'All', perp:'PERP', spot:'SPOT' } },


    { id: 'side',     varSetter: v => { filterSide = v; },


      labels: { all:'All', bid:'BID', ask:'ASK' } },


  ];





  // Inject exchange icons into dropdown items after EXCHANGES_LIST is ready


  function injectFddIcons() {


    EXCHANGES_LIST.forEach(({ key }) => {
      const el = document.getElementById('fdd-icon-' + key);
      if (el) el.innerHTML = exchIcon(key);
    });


  }


  // Run after DOM is ready (EXCHANGES_LIST defined above)


  requestAnimationFrame(injectFddIcons);





  let openId = null;





  function closeAll() {


    DDEFS.forEach(({ id }) => {


      const menu = document.getElementById('fdd-' + id + '-menu');


      const trigger = document.getElementById('fdd-' + id + '-trigger');


      if (menu) resetFloatMenu(menu);


      if (trigger) trigger.classList.remove('open');


    });


    openId = null;


  }





  DDEFS.forEach(({ id, varSetter, labels }) => {


    const trigger = document.getElementById('fdd-' + id + '-trigger');


    const menu    = document.getElementById('fdd-' + id + '-menu');


    const valEl   = document.getElementById('fdd-' + id + '-val');





    trigger.addEventListener('click', e => {


      e.stopPropagation();


      const isOpen = openId === id;


      closeAll();


      if (!isOpen) {


        menu.style.display = 'block';


        trigger.classList.add('open');


        positionFloatMenu(menu, trigger, { minWidth: trigger.offsetWidth });


        openId = id;


      }


    });


    trigger.addEventListener('keydown', e => {


      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); trigger.click(); }


      if (e.key === 'Escape') closeAll();


    });





    menu.querySelectorAll('.fdd-item').forEach(item => {


      item.addEventListener('click', e => {


        e.stopPropagation();


        const val = item.dataset.val;


        menu.querySelectorAll('.fdd-item').forEach(i => i.classList.remove('active'));


        item.classList.add('active');


        const tMap = { all: t('val_all'), bid: t('val_bid'), ask: t('val_ask'), perp: t('val_perp'), spot: t('val_spot') };
        valEl.textContent = tMap[val] || labels[val] || val;


        varSetter(val);


        closeAll();


        applyFilters();


      });


    });


  });





  // Close on outside click


  document.addEventListener('click', closeAll);





  // Expose reset helper for resetFilters()


  window._fddReset = function() {


    DDEFS.forEach(({ id, labels }) => {


      const menu  = document.getElementById('fdd-' + id + '-menu');


      const valEl = document.getElementById('fdd-' + id + '-val');


      if (menu) {


        menu.querySelectorAll('.fdd-item').forEach(i => i.classList.toggle('active', i.dataset.val === 'all'));


      }


      if (valEl) valEl.textContent = labels['all'] || 'All';


    });


  };


})();





document.getElementById('search-input').addEventListener('input', e => {


  filterText = e.target.value.trim(); applyFilters();


});


// Reset via double-click on search or via future UI


function resetFilters() {


  filterExchange='all'; filterMarket='all'; filterSide='all'; filterText=''; favsOnly=false;


  document.getElementById('search-input').value='';


  if (window._fddReset) window._fddReset();


  document.getElementById('favs-btn').classList.remove('on');


  applyFilters();


}


document.getElementById('search-input').addEventListener('dblclick', resetFilters);





// Favorites only toggle


document.getElementById('favs-btn').addEventListener('click', function() {


  favsOnly = !favsOnly;


  this.classList.toggle('on', favsOnly);


  applyFilters();


});





// Sound type buttons


document.getElementById('sp-sound-types').addEventListener('click', e => {
  const btn = e.target.closest('.sp-sound-btn');
  if (btn) {
    document.querySelectorAll('#sp-sound-types .sp-sound-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const isOff = btn.dataset.sound === 'off';
    if (draftSettings) {
      draftSettings.soundOn = !isOff;
      if (!isOff) draftSettings.soundType = btn.dataset.sound;
    }
    if (!isOff) {
      const vol = Math.max(0.001, (parseInt(document.getElementById('sp-sound-vol')?.value || 20)) / 100 * 0.35);
      try { _playSound(btn.dataset.sound, vol); } catch(e) {}
    }
  }
});





// Volume slider helper


function updateVolSlider(el) {
  const pct = el.value + '%';
  const track = getComputedStyle(document.body).getPropertyValue('--slider-track').trim() || '#1e2e1e';
  el.style.background = `linear-gradient(to right,var(--accent) 0%,var(--accent) ${pct},${track} ${pct},${track} 100%)`;
}


document.addEventListener('input', e => {


  if (e.target.id === 'sp-sound-vol') {


    updateVolSlider(e.target);


    const lbl = document.getElementById('sp-vol-label');


    if (lbl) lbl.textContent = e.target.value + '%';


  }


});





const MIN_VOL_FLOOR = 50000;





function fmtNum(n) {


  if (n === '' || n == null) return '';


  const i = Math.round(Number(n));


  if (isNaN(i)) return '';


  return i.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');


}


function parseNum(s) {


  return parseInt(String(s).replace(/\s/g, '')) || 0;


}


function _fmtInput(inp) {


  const raw = parseNum(inp.value);


  const pos = inp.selectionStart;


  const oldLen = inp.value.length;


  inp.value = raw ? fmtNum(raw) : '';


  // keep cursor roughly in place


  const diff = inp.value.length - oldLen;


  try { inp.setSelectionRange(pos + diff, pos + diff); } catch(_) {}


}





function _enforceMinFloor(inp) {


  const v = parseNum(inp.value);


  if (v < MIN_VOL_FLOOR) {


    inp.value = fmtNum(MIN_VOL_FLOOR);


    inp.style.borderColor = 'var(--accent)';


    setTimeout(() => { inp.style.borderColor = ''; }, 800);


  } else {


    inp.value = fmtNum(v);


  }


}


document.addEventListener('input', e => {


  if (e.target.classList.contains('exch-sf-input') && !e.target.classList.contains('sf-disabled')) {


    _fmtInput(e.target);


  }


}, true);


document.addEventListener('blur', e => {


  if (e.target.classList.contains('exch-sf-input') ||


      e.target.classList.contains('coin-vol-input')) {


    _enforceMinFloor(e.target);


  }


}, true);





// ══ Symbol autocomplete ═══════════════════════════════════════


(function() {


  const dd      = document.getElementById('coin-sym-dropdown');


  let activeInp = null;


  let onSelect  = null;


  let hoverIdx  = -1;





  function getSymbols(query) {


    const all = [...symCards.keys()].sort();


    if (!query) return all;


    const q = query.toUpperCase();


    return all.filter(s => s.startsWith(q));


  }





  function positionDd(inp) {


    const r = inp.getBoundingClientRect();


    dd.style.left  = r.left + 'px';


    dd.style.top   = (r.bottom + 4) + 'px';


    dd.style.width = r.width + 'px';


  }





  function renderDd(syms) {


    hoverIdx = -1;


    if (!syms.length) {


      dd.innerHTML = '<div class="csd-empty">No matches</div>';


    } else {


      dd.innerHTML = syms.map((s, i) =>


        `<div class="csd-item" data-idx="${i}" data-sym="${s}">${s}</div>`


      ).join('');


      dd.querySelectorAll('.csd-item').forEach(el => {


        el.addEventListener('mousedown', e => {


          e.preventDefault(); // prevent blur before mousedown


          const sym = el.dataset.sym;


          if (activeInp) activeInp.value = sym;


          if (onSelect)  onSelect(sym);


          hideDd();


        });


      });


    }


  }





  function showDd(inp, cb) {


    activeInp = inp;


    onSelect  = cb;


    positionDd(inp);


    const syms = getSymbols(inp.value);


    renderDd(syms);


    dd.classList.add('open');


  }





  function hideDd() {


    dd.classList.remove('open');


    activeInp = null;


    onSelect  = null;


    hoverIdx  = -1;


  }





  function handleKey(e) {


    if (!dd.classList.contains('open')) return;


    const items = [...dd.querySelectorAll('.csd-item')];


    if (!items.length) return;


    if (e.key === 'ArrowDown') {


      e.preventDefault();


      hoverIdx = Math.min(hoverIdx + 1, items.length - 1);


    } else if (e.key === 'ArrowUp') {


      e.preventDefault();


      hoverIdx = Math.max(hoverIdx - 1, 0);


    } else if (e.key === 'Enter') {


      if (hoverIdx >= 0 && items[hoverIdx]) items[hoverIdx].dispatchEvent(new MouseEvent('mousedown'));


      return;


    } else if (e.key === 'Escape') {


      hideDd(); return;


    } else { return; }


    items.forEach((el, i) => el.classList.toggle('active', i === hoverIdx));


    items[hoverIdx]?.scrollIntoView({ block: 'nearest' });


  }





  document.addEventListener('keydown', handleKey);


  document.addEventListener('click', e => {


    if (!dd.contains(e.target) && e.target !== activeInp) hideDd();


  });


  window.addEventListener('scroll', () => { if (activeInp) positionDd(activeInp); }, true);





  // Expose


  window._coinSymDd = { show: showDd, hide: hideDd };


})();





// ══ Settings panel ════════════════════════════════════════════


function buildExchRows(draft) {


  const c = document.getElementById('sp-exch-rows');


  c.innerHTML = '';


  EXCHANGES_LIST.forEach(({ key, label, abbr, domain, color }) => {


    const mins = (draft.exchangeMins||{})[key] || {s:50000,f:50000};


    const ee   = (draft.exchangeEnabled||{})[key] || {s:true,f:true};


    const sOn  = ee.s !== false;


    const fOn  = ee.f !== false;


    const row  = document.createElement('div');


    row.className = 'exch-sf-row';


    row.dataset.exchKey = key;


    row.innerHTML = `


      <div class="exch-sf-logo">


        <img src="https://www.google.com/s2/favicons?domain=${domain}&sz=64" width="17" height="17" style="border-radius:3px;display:block;${(!sOn&&!fOn)?'filter:grayscale(1) opacity(.3)':(!sOn||!fOn)?'filter:grayscale(.4) opacity(.65)':''}" onerror="_faveErr(this,'${abbr}','${color}',9)">


      </div>


      <span class="exch-sf-name" style="color:${(!sOn&&!fOn)?'var(--muted)':(!sOn||!fOn)?color+'99':color}">${label}</span>


      <span class="exch-sf-label${sOn?'':' sf-label-off'}" style="color:${sOn?color:'var(--muted)'}">S</span>


      <input class="exch-sf-input${sOn?'':' sf-disabled'}" type="text" inputmode="numeric"


        data-key="${key}" data-type="s"


        value="${sOn?fmtNum(mins.s):'——'}" ${sOn?'':'readonly tabindex="-1"'}>


      <span class="exch-sf-label${fOn?'':' sf-label-off'}" style="color:${fOn?color:'var(--muted)'}">F</span>


      <input class="exch-sf-input${fOn?'':' sf-disabled'}" type="text" inputmode="numeric"


        data-key="${key}" data-type="f"


        value="${fOn?fmtNum(mins.f):'——'}" ${fOn?'':'readonly tabindex="-1"'}>


    `;


    c.appendChild(row);


  });


}





function _applyCoinListSearch() {


  const q = (document.getElementById('coin-list-search')?.value || '').trim().toUpperCase();


  document.querySelectorAll('#coin-list .coin-item').forEach(item => {


    if (!q) { item.style.display = ''; return; }


    const sym = (item.querySelector('.coin-sym-select')?.value || '').toUpperCase();


    item.style.display = sym.startsWith(q) ? '' : 'none';


  });


}





function buildCoinList(draft) {


  const c = document.getElementById('coin-list');


  c.innerHTML = '';


  (draft.coinList||[]).forEach((coin, idx) => appendCoinItem(coin, idx, draft));


  _applyCoinListSearch(); // keep filter after rebuild


}





function _checkDuplicate(item, sym, idx, draft) {


  const isDup = sym && draft.coinList.some((c, i) => i !== idx && c.symbol === sym);


  item.classList.toggle('duplicate', isDup);


  // add/remove badge


  let badge = item.querySelector('.coin-dup-badge');


  if (isDup && !badge) {


    badge = document.createElement('span');


    badge.className = 'coin-dup-badge';


    badge.textContent = 'Duplicate';


    item.querySelector('.coin-top').insertBefore(badge, item.querySelector('[data-action="eye"]'));


  } else if (!isDup && badge) {


    badge.remove();


  }


}





function appendCoinItem(coin, idx, draft) {


  const c    = document.getElementById('coin-list');


  const item = document.createElement('div');


  item.className = 'coin-item' + (coin.visible===false?' hidden-coin':'');


  item.dataset.idx = idx;


  const eyeHidden = coin.visible===false;





  const exchBtns = EXCHANGES_LIST.map(ex => {


    const isOff = coin.exchanges && coin.exchanges[ex.key] && coin.exchanges[ex.key].enabled===false;


    const ee = (draft.exchangeEnabled||{})[ex.key] || {s:true,f:true};


    const globallyOff = ee.s === false && ee.f === false;


    const cls = globallyOff ? ' globally-off' : (isOff ? ' off' : '');


    const title = globallyOff ? `${ex.label} (disabled globally)` : ex.label;


    return `<button class="coin-exch-btn${cls}" data-exch="${ex.key}" title="${title}">


      <img src="https://www.google.com/s2/favicons?domain=${ex.domain}&sz=32" width="16" height="16" style="border-radius:3px;display:block" onerror="_faveErr(this,'${ex.abbr}','${ex.color}',8)">


    </button>`;


  }).join('');





  item.innerHTML = `


    <div class="coin-top">


      <input class="coin-sym-select" type="text" placeholder="BTCUSDT" value="${coin.symbol||''}" maxlength="20" autocomplete="off">


      <input class="coin-vol-input" type="text" inputmode="numeric" placeholder="Min vol $" value="${coin.minVol ? fmtNum(coin.minVol) : ''}">


      <button class="coin-circle-btn${eyeHidden?' hidden':''}" data-action="eye" data-tip-key="${eyeHidden?'tip_show':'tip_hide'}">


        ${eyeHidden


          ? `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`


          : `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`}


      </button>


      <button class="coin-circle-btn del" data-action="del" data-tip-key="tip_remove">


        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>


      </button>


    </div>


    <div class="coin-bottom">


      <div class="coin-mkt-group">


        <label class="coin-chk-label">


          <input type="checkbox" ${coin.mkt_s!==false?'checked':''} data-field="mkt_s">


          <span>S</span>


        </label>


        <label class="coin-chk-label">


          <input type="checkbox" ${coin.mkt_f!==false?'checked':''} data-field="mkt_f">


          <span>F</span>


        </label>


      </div>


      <div style="display:flex;gap:5px;align-items:center;flex-wrap:wrap">${exchBtns}</div>


    </div>


  `;





  item.querySelector('[data-action="eye"]').addEventListener('click', () => {


    draft.coinList[idx].visible = draft.coinList[idx].visible===false ? true : false;


    buildCoinList(draft);


  });


  item.querySelector('[data-action="del"]').addEventListener('click', () => {


    draft.coinList.splice(idx,1); buildCoinList(draft);


  });


  const symInp = item.querySelector('.coin-sym-select');





  function _onSymPick(sym) {


    symInp.value = sym;


    draft.coinList[idx].symbol = sym;


    _checkDuplicate(item, sym, idx, draft);


  }





  symInp.addEventListener('focus', () => {


    window._coinSymDd?.show(symInp, _onSymPick);


  });


  symInp.addEventListener('input', e => {


    const v = e.target.value.toUpperCase();


    e.target.value = v;


    window._coinSymDd?.show(symInp, _onSymPick);


  });


  symInp.addEventListener('blur', () => {


    setTimeout(() => window._coinSymDd?.hide(), 120);


  });





  // Check on initial render (e.g. if draft already had a dup)


  _checkDuplicate(item, coin.symbol, idx, draft);


  item.querySelector('.coin-vol-input').addEventListener('input', e => {


    _fmtInput(e.target);


    draft.coinList[idx].minVol = parseNum(e.target.value);


  });


  item.querySelector('.coin-vol-input').addEventListener('blur', e => {


    const v = parseNum(e.target.value);


    if (v < MIN_VOL_FLOOR) {


      e.target.value = fmtNum(MIN_VOL_FLOOR);


      draft.coinList[idx].minVol = MIN_VOL_FLOOR;


    } else {


      e.target.value = fmtNum(v);


      draft.coinList[idx].minVol = v;


    }


  });


  item.querySelectorAll('[data-field]').forEach(chk => {


    chk.addEventListener('change', () => {


      draft.coinList[idx][chk.dataset.field] = chk.checked;


    });


  });


  item.querySelectorAll('.coin-exch-btn').forEach(btn => {


    btn.addEventListener('click', () => {


      const exKey = btn.dataset.exch;


      if (!draft.coinList[idx].exchanges) draft.coinList[idx].exchanges = {};


      if (!draft.coinList[idx].exchanges[exKey]) draft.coinList[idx].exchanges[exKey] = {enabled:true};


      const cur = draft.coinList[idx].exchanges[exKey].enabled;


      draft.coinList[idx].exchanges[exKey].enabled = !cur;


      btn.classList.toggle('off', cur); // if was on, now off


    });


  });


  c.appendChild(item);


}





function _updateExchSelectRowState(row, ee, color) {


  const sOn = ee.s !== false, fOn = ee.f !== false;


  row.classList.toggle('one-off',  (sOn !== fOn));


  row.classList.toggle('both-off', (!sOn && !fOn));


  const nameEl = row.querySelector('.exch-row-name');


  if (nameEl) nameEl.style.color = (!sOn&&!fOn) ? 'var(--muted)' : (!sOn||!fOn) ? color+'99' : color;


}





function buildExchSelection(draft) {


  const c = document.getElementById('sp-exch-selection');


  if (!c) return;


  c.innerHTML = '';


  if (!draft.exchangeEnabled) draft.exchangeEnabled = JSON.parse(JSON.stringify(DEFAULT_EXCH_ENABLED));


  EXCHANGES_LIST.forEach(({ key, label, abbr, domain, color }) => {


    const ee = draft.exchangeEnabled[key] || {s:true,f:true};


    const sOn = ee.s !== false, fOn = ee.f !== false;


    const row = document.createElement('div');


    row.className = 'exch-select-row' + (!sOn&&!fOn?' both-off':(!sOn||!fOn)?' one-off':'');


    row.innerHTML = `


      <div class="exch-circle">


        <img src="https://www.google.com/s2/favicons?domain=${domain}&sz=64" width="20" height="20"


          style="border-radius:3px;display:block" onerror="_faveErr(this,'${abbr}','${color}',10)">


      </div>


      <span class="exch-row-name" style="flex:1;font-size:11.5px;font-weight:700;color:${(!sOn&&!fOn)?'var(--muted)':(!sOn||!fOn)?color+'99':color}">${label}</span>


      <div class="exch-chk-group">


        <label class="exch-chk-lbl">


          <input type="checkbox" ${sOn?'checked':''} data-key="${key}" data-type="s">


          <span>Spot</span>


        </label>


        <label class="exch-chk-lbl">


          <input type="checkbox" ${fOn?'checked':''} data-key="${key}" data-type="f">


          <span>Futures</span>


        </label>


      </div>


    `;


    row.querySelectorAll('input[type=checkbox]').forEach(chk => {


      chk.addEventListener('change', () => {


        if (!draft.exchangeEnabled[key]) draft.exchangeEnabled[key]={s:true,f:true};


        draft.exchangeEnabled[key][chk.dataset.type] = chk.checked;


        _updateExchSelectRowState(row, draft.exchangeEnabled[key], color);


        // Rebuild min-size rows to reflect enabled state


        buildExchRows(draft);


        // Rebuild coin list to reflect per-exchange disabled state


        buildCoinList(draft);


      });


    });


    c.appendChild(row);


  });


}





function syncSortUI(draft) {


  const sel = document.getElementById('sp-sort-select');


  if (sel) sel.value = draft.sortBy || 'time';


  const ob = document.getElementById('sort-order-btn');


  if (ob) {


    const desc = draft.sortOrder === 'desc';


    ob.textContent = desc ? '↓' : '↑';


    ob.classList.toggle('on', desc);


  }


}





function populateSettingsForm(draft) {


  buildExchRows(draft);


  buildExchSelection(draft);


  buildCoinList(draft);


  syncSortUI(draft);


  const dist = document.getElementById('sp-distance-select');


  if (dist) dist.value = draft.distancePct || '2';


  // Wall Age — from


  const tfv = document.getElementById('sp-time-from-val');


  const tfu = document.getElementById('sp-time-from-unit');


  if (tfv) tfv.value = (draft.timeFrom && draft.timeFrom.value != null) ? draft.timeFrom.value : '';


  if (tfu) tfu.value = (draft.timeFrom && draft.timeFrom.unit) ? draft.timeFrom.unit : 'minutes';


  // Wall Age — to


  const ttv = document.getElementById('sp-time-to-val');


  const ttu = document.getElementById('sp-time-to-unit');


  if (ttv) ttv.value = (draft.timeTo && draft.timeTo.value != null) ? draft.timeTo.value : '';


  if (ttu) ttu.value = (draft.timeTo && draft.timeTo.unit) ? draft.timeTo.unit : 'minutes';


  // Sound


  const sVol = document.getElementById('sp-sound-vol');


  const sLbl = document.getElementById('sp-vol-label');


  if (sVol) { sVol.value = draft.soundVolume ?? 20; updateVolSlider(sVol); }


  if (sLbl) sLbl.textContent = (draft.soundVolume ?? 20) + '%';


  const soundOn = draft.soundOn !== false;
  document.querySelectorAll('#sp-sound-types .sp-sound-btn').forEach(btn => {
    if (btn.dataset.sound === 'off') {
      btn.classList.toggle('active', !soundOn);
    } else {
      btn.classList.toggle('active', soundOn && btn.dataset.sound === (draft.soundType || 'chime'));
    }
  });


  buildQuoteCheckboxes(draft);


  buildCardStyleUI(draft);


  syncModeUI(screenerMode);


}


function _csSideDefaultHex(side) {
  const style = getComputedStyle(document.body);
  if (side === 'bid') {
    const v = style.getPropertyValue('--accent').trim();
    return v || '#5A99DD';
  }
  const v = style.getPropertyValue('--ask').trim();
  return v || '#CC4444';
}


const _CS_RESET_ICON = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>';


function _syncCsPickSwatch(lbl, hex) {
  if (!lbl) return;
  const span = lbl.querySelector('[data-cs-swatch]');
  const inp = lbl.querySelector('input[data-cs-color]');
  if (!span || !inp) return;
  const defHex = inp.dataset.defaultHex || _csSideDefaultHex(inp.dataset.side);
  span.style.background = hex || defHex;
  lbl.classList.toggle('is-custom', !!hex);
  const reset = lbl.closest('.cs-color-pair-row')?.querySelector('.cs-color-reset');
  if (reset) reset.classList.toggle('can-reset', !!hex);
}


function buildCardStyleUI(draft) {


  const wrap = document.getElementById('sp-card-style');


  if (!wrap) return;


  const cs = draft.cardStyle || DEFAULT_CARD_STYLE;


  const tiers = cs.tiers || DEFAULT_CARD_STYLE.tiers;





  wrap.innerHTML = tiers.map((tier, ti) => {


    const fromVal = tier.fromThresh != null && tier.fromThresh !== '' ? Number(tier.fromThresh).toLocaleString('en-US').replace(/,/g,' ') : '';


    const colorPairFor = (side) => {


      const cur = side === 'bid' ? tier.bidColor : tier.askColor;


      const defHex = _csSideDefaultHex(side);


      const displayHex = cur || defHex;


      const label = side === 'bid' ? 'Bid' : 'Ask';


      return `<div class="cs-color-pair">


        <div class="cs-color-group-label">${label}</div>


        <div class="cs-color-pair-row">


          <label class="cs-color-pick${cur ? ' is-custom' : ''}">


            <span data-cs-swatch style="background:${displayHex}"></span>


            <input type="hidden" data-cs-color data-tier="${ti}" data-side="${side}"


              data-default-hex="${defHex}" value="${cur || ''}">


          </label>


          <button type="button" class="cs-color-reset${cur ? ' can-reset' : ''}"


            data-tier="${ti}" data-side="${side}" title="Reset to default color">${_CS_RESET_ICON}</button>


        </div>


      </div>`;


    };


    return `<div class="cs-tier">


      <div class="cs-tier-header">


        <span class="cs-tier-label">${tier.label}</span>


        <input class="cs-tier-thresh" type="text" inputmode="numeric" data-tier="${ti}"


          value="${fromVal}" placeholder="50 000" min="0">


        <span class="cs-tier-thresh-label">$ from</span>


      </div>


      <div class="cs-colors">


        ${colorPairFor('bid')}


        ${colorPairFor('ask')}


      </div>


    </div>`;


  }).join('');





  wrap.querySelectorAll('.cs-color-reset').forEach(btn => {
    btn.addEventListener('click', () => {
      const ti = btn.dataset.tier;
      const side = btn.dataset.side;
      const inp = wrap.querySelector(`input[data-cs-color][data-tier="${ti}"][data-side="${side}"]`);
      const lbl = inp?.closest('.cs-color-pick');
      if (inp) inp.value = '';
      if (lbl) _syncCsPickSwatch(lbl, '');
    });
  });

  wrap.querySelectorAll('.cs-color-pick').forEach(lbl => {
    lbl.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      const inp = lbl.querySelector('input[data-cs-color]');
      if (!inp || !window._openAppColorPop) return;
      const seed = inp.value || inp.dataset.defaultHex || _csSideDefaultHex(inp.dataset.side);
      window._openAppColorPop(inp, lbl, { seed });
    });
  });


}


function collectCardStyleDraft() {


  if (!draftSettings) return;


  const wrap = document.getElementById('sp-card-style');


  if (!wrap) return;


  const cs = draftSettings.cardStyle || JSON.parse(JSON.stringify(DEFAULT_CARD_STYLE));


  const tiers = cs.tiers;


  // Collect thresholds (fromThresh = lower bound for this tier)


  wrap.querySelectorAll('.cs-tier-thresh').forEach(inp => {


    const ti = +inp.dataset.tier;


    const v = parseFloat(inp.value.replace(/\s/g,''));


    tiers[ti].fromThresh = isNaN(v) ? 0 : v;


  });


  wrap.querySelectorAll('input[data-cs-color]').forEach(inp => {
    const ti = +inp.dataset.tier;
    const side = inp.dataset.side;
    const color = (inp.value || '').trim();
    if (side === 'bid') tiers[ti].bidColor = color;
    else                tiers[ti].askColor = color;
  });


  draftSettings.cardStyle = cs;


}





function buildQuoteCheckboxes(draft) {


  const grid = document.getElementById('sp-quotes-grid');


  if (!grid) return;


  const qe = draft.quotesEnabled || DEFAULT_QUOTES_ENABLED;


  grid.innerHTML = ALL_QUOTES.map(q => `


    <label class="sp-quote-lbl">


      <input type="checkbox" class="sp-quote-chk" data-quote="${q}"${qe[q] !== false ? ' checked' : ''}>


      <span>${q}</span>


    </label>`).join('');


}


function syncModeUI(mode) {


  const hasBinanceF = [...densities.values()].some(d => d.binance_f);


  const binBtn = document.getElementById('sp-mode-binance-btn');


  if (binBtn) {


    binBtn.disabled = !hasBinanceF;


    binBtn.style.opacity = hasBinanceF ? '' : '0.35';


    binBtn.title = hasBinanceF ? '' : 'Binance Futures not connected';


    if (!hasBinanceF && mode === 'binance_only') mode = 'all';


  }


  document.getElementById('sp-mode-binance-btn')?.classList.toggle('active', mode === 'binance_only');


  document.getElementById('sp-mode-all-btn')?.classList.toggle('active', mode === 'all');


  document.getElementById('sp-mode-hide-rwa-btn')?.classList.toggle('active', !hideRwa);


}


document.getElementById('sp-mode-binance-btn')?.addEventListener('click', () => {


  const hasBinanceF = [...densities.values()].some(d => d.binance_f);


  if (!hasBinanceF) return;


  screenerMode = 'binance_only'; syncModeUI(screenerMode);


  [...symCards.keys()].forEach(sym => renderCard(sym)); reorderGrid(); updateStats();


});


document.getElementById('sp-mode-all-btn')?.addEventListener('click', () => {


  screenerMode = 'all'; syncModeUI(screenerMode);


  [...symCards.keys()].forEach(sym => renderCard(sym)); reorderGrid(); updateStats();


});


document.getElementById('sp-mode-hide-rwa-btn')?.addEventListener('click', () => {


  hideRwa = !hideRwa; syncModeUI(screenerMode);


  [...symCards.keys()].forEach(sym => renderCard(sym)); reorderGrid(); updateStats();


});


let _settingsSnapshot = null;   // settings state at moment of opening


let _settingsDirty    = false;  // user changed something but didn't save


let _autoSyncTimer    = null;





function openSettings() {


  _settingsSnapshot = JSON.parse(JSON.stringify(settings));


  draftSettings     = JSON.parse(JSON.stringify(settings));


  _settingsDirty    = false;


  const srch = document.getElementById('coin-list-search');


  if (srch) srch.value = '';


  populateSettingsForm(draftSettings);


  document.getElementById('settings-overlay').classList.add('open');


  // Auto-sync every 1 s: apply draft to live (without saving to localStorage)


  _autoSyncTimer = setInterval(() => {


    if (!draftSettings) return;


    collectDraft();


    const prev = JSON.stringify(settings);


    const next = JSON.stringify(draftSettings);


    if (prev === next) return;


    _settingsDirty = true;


    // Apply live (no localStorage write)


    settings = JSON.parse(JSON.stringify(draftSettings));


    soundOn     = settings.soundOn !== false;


    soundVolume = settings.soundVolume ?? 20;


    soundType   = settings.soundType   || 'chime';


    [...symCards.keys()].forEach(sym => renderCard(sym));


    reorderGrid(); updateStats();


  }, 1000);


}





function _closeSettingsForce() {


  clearInterval(_autoSyncTimer); _autoSyncTimer = null;


  document.getElementById('settings-overlay').classList.remove('open');


  _settingsDirty = false;


  draftSettings = null;


  _settingsSnapshot = null;


}





function closeSettings() {


  if (_settingsDirty) {


    // Show unsaved-changes dialog


    document.getElementById('sp-unsaved-overlay').classList.add('open');


    return;


  }


  // Revert live settings to snapshot (user didn't save anything)


  if (_settingsSnapshot) {


    settings = JSON.parse(JSON.stringify(_settingsSnapshot));


    soundOn     = settings.soundOn !== false;


    soundVolume = settings.soundVolume ?? 20;


    soundType   = settings.soundType   || 'chime';


    [...symCards.keys()].forEach(sym => renderCard(sym));


    reorderGrid(); updateStats();


  }


  _closeSettingsForce();


}


function collectDraft() {


  if (!draftSettings) return;


  // Min sizes


  document.querySelectorAll('.exch-sf-input').forEach(inp => {


    if (inp.classList.contains('sf-disabled')) return; // market disabled — skip


    const k=inp.dataset.key, t=inp.dataset.type;


    if (!draftSettings.exchangeMins[k]) draftSettings.exchangeMins[k]={};


    draftSettings.exchangeMins[k][t] = Math.max(MIN_VOL_FLOOR, parseNum(inp.value)||MIN_VOL_FLOOR);


  });


  // Sort / distance (exchange enabled already updated reactively)


  const sel = document.getElementById('sp-sort-select');  if (sel) draftSettings.sortBy = sel.value;


  const dist = document.getElementById('sp-distance-select'); if (dist) draftSettings.distancePct = dist.value;


  // Wall Age — from


  const tfv = document.getElementById('sp-time-from-val');


  const tfu = document.getElementById('sp-time-from-unit');


  draftSettings.timeFrom = {


    value: tfv && tfv.value.trim() !== '' ? tfv.value.trim() : '',


    unit:  tfu ? tfu.value : 'minutes'


  };


  // Wall Age — to


  const ttv = document.getElementById('sp-time-to-val');


  const ttu = document.getElementById('sp-time-to-unit');


  draftSettings.timeTo = {


    value: ttv && ttv.value.trim() !== '' ? ttv.value.trim() : '',


    unit:  ttu ? ttu.value : 'minutes'


  };


  // Sound


  const sVol = document.getElementById('sp-sound-vol');


  if (sVol) draftSettings.soundVolume = parseInt(sVol.value) || 0;


  const offBtn = document.getElementById('sp-sound-off-btn');
  draftSettings.soundOn = !(offBtn && offBtn.classList.contains('active'));


  const activeSound = document.querySelector('#sp-sound-types .sp-sound-btn.active:not([data-sound="off"])');


  if (activeSound) draftSettings.soundType = activeSound.dataset.sound;


  // Quote currencies


  const qe = {};


  document.querySelectorAll('.sp-quote-chk').forEach(chk => { qe[chk.dataset.quote] = chk.checked; });


  if (Object.keys(qe).length) draftSettings.quotesEnabled = qe;


  // Card style


  collectCardStyleDraft();


}


function commitSettings() {


  collectDraft();


  settings = JSON.parse(JSON.stringify(draftSettings));


  saveSettings();


  // Apply sound settings immediately


  soundOn     = settings.soundOn !== false;


  soundVolume = settings.soundVolume ?? 20;


  soundType   = settings.soundType   || 'chime';


  [...symCards.keys()].forEach(sym => renderCard(sym));


  reorderGrid(); updateStats();


  _settingsDirty = false;


  _closeSettingsForce();


}





function openSettingsForSymbol(symbol) {


  openSettings();


  const exists = draftSettings.coinList.find(c => c.symbol===symbol.toUpperCase());


  if (!exists) {


    draftSettings.coinList.push({ symbol:symbol.toUpperCase(), minVol:0, visible:true, mkt_s:true, mkt_f:true });


    buildCoinList(draftSettings);


  }


  setTimeout(() => {


    document.getElementById('coin-list').lastElementChild?.scrollIntoView({behavior:'smooth',block:'nearest'});


  }, 120);


}





function hideSymbolViaSettings(symbol) {


  openSettings();


  const sym = symbol.toUpperCase();


  const idx = draftSettings.coinList.findIndex(c => c.symbol === sym);


  if (idx >= 0) {


    draftSettings.coinList[idx].visible = false;


  } else {


    draftSettings.coinList.push({ symbol: sym, minVol: 0, visible: false, mkt_s: true, mkt_f: true });


  }


  buildCoinList(draftSettings);


  setTimeout(() => {


    // scroll coin list to the hidden item


    const items = document.querySelectorAll('#coin-list .coin-item');


    if (items.length) items[items.length - 1].scrollIntoView({ behavior: 'smooth', block: 'nearest' });


  }, 150);


}





['stats-settings-btn','nav-settings'].forEach(id => {


  document.getElementById(id)?.addEventListener('click', openSettings);


});


document.getElementById('sp-close').addEventListener('click', closeSettings);
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    const overlay = document.getElementById('settings-overlay');
    if (overlay && overlay.classList.contains('open')) closeSettings();
    const splashOverlay = document.getElementById('splash-sp-overlay');
    if (splashOverlay && splashOverlay.classList.contains('open')) splashOverlay.classList.remove('open');
  }
});


document.getElementById('sp-cancel').addEventListener('click', closeSettings);


document.getElementById('settings-overlay').addEventListener('click', e => {


