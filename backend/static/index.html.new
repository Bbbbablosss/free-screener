        <div class="ws-action" id="ws-create-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create workspace
        </div>
        <div class="ws-divider"></div>
        <div class="ws-list-label">List</div>
        <div id="ws-list"></div>
    </div>
  </div>

      <div class="tb-profile-wrap" id="tb-profile-wrap">
        <button type="button" class="tb-btn tb-icon-btn" id="tb-profile-btn" title="Profile">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </button>
        <div class="tb-profile-menu" id="tb-profile-menu" style="display:none">
          <button type="button" class="tb-profile-item" id="tb-profile-menu-profile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span id="tb-profile-lbl-profile">Profile</span>
          </button>
          <button type="button" class="tb-profile-item tb-profile-item--invite" id="tb-profile-menu-invite">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span id="tb-profile-lbl-invite">Invite a friend</span>
          </button>
          <button type="button" class="tb-profile-item tb-profile-item--logout" id="tb-profile-menu-logout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span id="tb-profile-lbl-logout">Log out</span>
          </button>
        </div>
      </div>

      <div class="sb-lang-wrap" id="sb-lang-wrap">
        <button type="button" class="tb-btn tb-lang-btn" id="sb-lang-btn" title="Language">
          <span class="tb-lang-code" id="sb-lang-val">En</span>
          <svg class="sb-lang-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="sb-lang-menu" id="sb-lang-menu">
          <div class="sb-lang-item" data-lang="en">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span class="sb-lang-item-name">English</span>
            <span class="sb-lang-item-code">EN</span>
          </div>
          <div class="sb-lang-item" data-lang="es">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span class="sb-lang-item-name">Español</span>
            <span class="sb-lang-item-code">ES</span>
          </div>
        </div>
      </div>

