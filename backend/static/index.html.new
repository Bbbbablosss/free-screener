            <span class="ch-cs-row-label">Wick</span>
            <div class="ch-cs-colors">
              <label class="ch-cs-swatch"><span data-swatch="wickUp"></span><input type="color" data-field="wickUp"></label>
              <label class="ch-cs-swatch"><span data-swatch="wickDown"></span><input type="color" data-field="wickDown"></label>
            </div>
          </div>
          <div class="ch-cs-section" style="margin-top:14px">Watermark</div>
          <div class="ch-cs-row" data-row="wm">
            <button type="button" class="ch-cs-check" data-field="wmOn" aria-label="Watermark"></button>
            <span class="ch-cs-row-label">Watermark</span>
            <div class="ch-cs-colors">
              <label class="ch-cs-swatch"><span data-swatch="wmColor"></span><input type="color" data-field="wmColor"></label>
            </div>
          </div>
        </div>
        <div class="ch-cs-pane" data-pane="appearance">
          <div class="ch-cs-section">Main Chart Style</div>
          <div class="ch-cs-field">
            <label for="ch-cs-bg">Background Color</label>
            <select class="ch-cs-select" id="ch-cs-bg-type" disabled><option>Solid</option></select>
            <label class="ch-cs-swatch"><span data-swatch="bg"></span><input type="color" data-field="bg"></label>
          </div>
          <div class="ch-cs-field">
            <label for="ch-cs-grid-mode">Grid</label>
