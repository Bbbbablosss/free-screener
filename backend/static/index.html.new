      </div>
    </div>

    <div class="ls-table-card ls-panel-hidden" id="ls-panel-delistings">
      <div class="ls-table-head">
        <div class="ls-table-title"><span id="ls-del-title-lbl">New Delistings</span> <span class="ls-count" id="ls-del-count">0</span></div>
        <div class="ls-table-actions">
          <div class="ls-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
            <input id="ls-del-search" type="text" placeholder="Search coins" autocomplete="off">
          </div>
        </div>
      </div>
      <div class="ls-table-wrap">
        <table class="ls-table ls-table-del" id="ls-del-table">
          <thead>
            <tr>
              <th class="ls-col-ticker" id="ls-th-ticker2">Ticker</th>
              <th class="ls-col-ex" id="ls-th-ex2">Exchange</th>
              <th class="ls-col-desc" id="ls-th-desc2">Description</th>
              <th class="ls-col-date" id="ls-th-date2">Date</th>
            </tr>
          </thead>
          <tbody id="ls-del-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ══ Charts section ══ -->
  <div id="charts-main">
    <div id="ch-mview" role="tablist" aria-label="View">
      <button type="button" id="ch-mview-list" data-mv="list">List</button>
      <button type="button" id="ch-mview-chart" data-mv="chart">Chart</button>
    </div>
    <div id="ch-right" class="card ch-chart-card ch-dock-panel ch-dock-flex" data-ch-panel="chart">
      <div id="ch-chart-bar">
        <div class="ch-chart-bar-grip" title="Move panel">
          <span class="ch-dock-grip-dot"></span><span class="ch-dock-grip-dot"></span><span class="ch-dock-grip-dot"></span>
          <span class="ch-dock-grip-dot"></span><span class="ch-dock-grip-dot"></span><span class="ch-dock-grip-dot"></span>
        </div>
        <div id="ch-bar-start">
        <div id="ch-header-search" class="tb-btn tb-lang-btn ch-tb-search" style="cursor:pointer;" title="Ticker search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          <input id="ch-wl-search-inp" type="text" placeholder="Ticker name…" autocomplete="off" readonly style="cursor:pointer;pointer-events:none;">
        </div>

        <button type="button" id="ch-draw-toggle" class="tb-btn tb-icon-btn ch-draw-toggle" title="Drawing tools" aria-expanded="false">
          <svg class="icon-pencil" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
          <svg class="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

        <div id="ch-draw-bar">
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn active" data-tool="cursor" title="Cursor">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="12" y1="4" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="20"/><line x1="4" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="20" y2="12"/></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="hray" title="Horizontal ray">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="5" cy="12" r="2.5"/><line x1="8" y1="12" x2="22" y2="12"/></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="hline" title="Horizontal line">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="2" y1="12" x2="22" y2="12"/><circle cx="12" cy="12" r="2.5"/></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="tline" title="Trend line">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="5" cy="19" r="2.5"/><line x1="7" y1="17" x2="17" y2="7"/><circle cx="19" cy="5" r="2.5"/></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="ray" title="Ray">
            <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="4" cy="20" r="2.4" fill="currentColor"/><line x1="6" y1="18.5" x2="22" y2="2" stroke="currentColor" stroke-width="1.8"/></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="rect" title="Rectangle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="6" width="16" height="12" rx="1"/></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="fib" title="Fibonacci retracement">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="4" y1="6" x2="14" y2="6"/><line x1="6" y1="10" x2="20" y2="10"/><circle cx="20" cy="10" r="1.6" fill="currentColor" stroke="none"/><line x1="4" y1="14" x2="18" y2="14"/><line x1="8" y1="18" x2="16" y2="18"/><circle cx="8" cy="18" r="1.6" fill="currentColor" stroke="none"/></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="measure" title="Ruler (Shift+click)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><g transform="rotate(-45 12 12)"><rect x="5" y="9.5" width="14" height="5" rx="1"/><line x1="7.5" y1="11.5" x2="7.5" y2="12.8"/><line x1="10" y1="11.5" x2="10" y2="12.8"/><line x1="12.5" y1="11.5" x2="12.5" y2="12.8"/><line x1="15" y1="11.5" x2="15" y2="12.8"/></g></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="magnet" title="Magnet (snap to candle)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 4h4v8a3 3 0 006 0V4h4v8a7 7 0 01-14 0V4z"/><line x1="5" y1="8" x2="9" y2="8"/><line x1="15" y1="8" x2="19" y2="8"/></svg>
          </button>
          <button type="button" class="ch-draw-btn tb-btn tb-icon-btn" data-tool="erase" title="Delete all objects">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
          </button>
        </div>
        </div>
        <div id="ch-grid-pager" aria-label="Chart pagination">
          <button type="button" class="ch-gp-btn tb-btn tb-icon-btn" data-gp="first" title="First">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
          </button>
          <button type="button" class="ch-gp-btn tb-btn tb-icon-btn" data-gp="prev" title="Previous page">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <span class="ch-gp-count">1 / 1</span>
          <button type="button" class="ch-gp-btn tb-btn tb-icon-btn" data-gp="next" title="Next page">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <button type="button" class="ch-gp-btn tb-btn tb-icon-btn" data-gp="last" title="Last">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
          </button>
        </div>
        <div id="ch-chart-symbar" aria-hidden="true">
          <span id="ch-symbar-mkt" class="d-mkt-lbl f" title="Select exchange/market">F</span>
          <span id="ch-symbar-icon-coin" title="Select exchange/market"></span>
          <span id="ch-symbar-sym" title="Copy ticker">BTCUSDT</span>
          <span id="ch-symbar-tf">1ч</span>
          <div id="ch-exch-popup">
            <div class="ch-ep-section">
              <div class="ch-ep-head"><span class="d-mkt-lbl s">S</span> Spot</div>
              <div class="ch-ep-row" id="ch-ep-spot"></div>
            </div>
            <div class="ch-ep-section">
              <div class="ch-ep-head"><span class="d-mkt-lbl f">F</span> Futures</div>
              <div class="ch-ep-row" id="ch-ep-fut"></div>
            </div>
          </div>
        </div>
        <div id="ch-tf-row" aria-hidden="true">
          <button class="ch-tf-btn" data-tf="1">1м</button>
          <button class="ch-tf-btn" data-tf="5">5м</button>
          <button class="ch-tf-btn" data-tf="15">15м</button>
          <button class="ch-tf-btn active" data-tf="60">1ч</button>
          <button class="ch-tf-btn" data-tf="240">4ч</button>
          <button class="ch-tf-btn" data-tf="D">1д</button>
        </div>
        <div id="ch-chart-actions">
          <div id="ch-layout-wrap">
            <button type="button" class="tb-btn tb-icon-btn" id="ch-layout-btn" title="Chart layouts"></button>
            <div id="ch-layout-menu"></div>
          </div>
          <div id="ch-ind-wrap">
            <button type="button" class="tb-btn tb-icon-btn" id="ch-chart-indicators" title="Indicators">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="12" width="2.5" height="8" rx="0.5"/><rect x="8.5" y="9" width="2.5" height="11" rx="0.5"/><rect x="13" y="6" width="2.5" height="14" rx="0.5"/><polyline points="4,11 9,8 14,5 20,3"/></svg>
            </button>
            <div id="ch-ind-menu"></div>
          </div>
          <button type="button" class="tb-btn tb-icon-btn" id="ch-chart-settings" title="Chart settings">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </button>
        </div>
      </div>
      <div id="ch-grid-wrap">
        <div id="ch-grid"></div>
      </div>
      <div id="ch-draw-edit" aria-hidden="true">
        <button type="button" class="ch-de-btn ch-de-grip" title="Move">
          <svg width="10" height="14" viewBox="0 0 10 14" fill="currentColor"><circle cx="2" cy="2" r="1.2"/><circle cx="8" cy="2" r="1.2"/><circle cx="2" cy="7" r="1.2"/><circle cx="8" cy="7" r="1.2"/><circle cx="2" cy="12" r="1.2"/><circle cx="8" cy="12" r="1.2"/></svg>
        </button>
        <div class="ch-de-wrap" id="ch-de-color-wrap">
          <button type="button" class="ch-de-btn ch-de-color" id="ch-de-color" title="Color"></button>
          <div class="ch-de-pop" id="ch-de-color-pop">
            <div class="ch-de-colors" id="ch-de-colors"></div>
          </div>
        </div>
        <div class="ch-de-wrap" id="ch-de-width-wrap">
          <button type="button" class="ch-de-btn ch-de-width" id="ch-de-width" title="Thickness">
            <span class="ch-de-width-line"></span><span id="ch-de-width-lbl">1px</span>
          </button>
          <div class="ch-de-pop ch-de-menu" id="ch-de-width-pop"></div>
        </div>
        <div class="ch-de-wrap" id="ch-de-style-wrap">
          <button type="button" class="ch-de-btn ch-de-style" id="ch-de-style" title="Line style">
            <span class="ch-de-style-line" id="ch-de-style-preview"></span>
          </button>
          <div class="ch-de-pop ch-de-menu" id="ch-de-style-pop"></div>
        </div>
        <button type="button" class="ch-de-btn" id="ch-de-delete" title="Delete">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
        </button>
      </div>
    </div>
    <div id="ch-left" class="ch-dock-panel" data-ch-panel="watchlist">
      <div id="ch-wl-resize" title="Resize width"></div>
      <div class="ch-dock-grip ch-dock-grab-handle" title="Move block">
        <span class="ch-dock-grip-dot"></span><span class="ch-dock-grip-dot"></span><span class="ch-dock-grip-dot"></span>
        <span class="ch-dock-grip-dot"></span><span class="ch-dock-grip-dot"></span><span class="ch-dock-grip-dot"></span>
      </div>
      <div id="ch-wl-top">
        <div id="ch-exch-wrap">
          <button id="ch-exch-btn" type="button">
            <span id="ch-exch-btn-icon" style="width:16px;height:16px;flex-shrink:0;display:flex;align-items:center;justify-content:center;"></span>
            <span id="ch-exch-name">OKX Futures</span>
            <svg width="9" height="6" viewBox="0 0 9 6" fill="none" style="flex-shrink:0"><path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </button>
          <div id="ch-exch-menu"></div>
        </div>
        <div class="ch-wl-top-search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          <input id="ch-wl-list-search" type="text" placeholder="Search…" autocomplete="off" spellcheck="false">
        </div>
        <div class="ch-wl-top-spacer" aria-hidden="true"></div>
        <div id="ch-wl-menu-wrap">
          <button type="button" id="ch-wl-menu-btn" title="Settings">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span id="ch-wl-menu-btn-label">Settings</span>
          </button>
          <div id="ch-params-panel">
            <div class="ch-pp-header" id="ch-pp-title">Parameter list</div>
            <div class="ch-pp-item" data-param="price_change">
              <span class="ch-pp-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></span>
              <span class="ch-pp-label" data-param-label="price_change">Price change</span>
              <svg class="ch-pp-chevron" id="ch-pchg-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="transition:transform .2s"><polyline points="9 6 15 12 9 18"/></svg>
            </div>
            <div id="ch-pchg-sub">
              <div class="ch-pchg-row" data-tf="1m"><span class="ch-pchg-check"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg></span><span class="ch-pchg-label">1 min</span></div>
              <div class="ch-pchg-row" data-tf="5m"><span class="ch-pchg-check"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg></span><span class="ch-pchg-label">5 min</span></div>
              <div class="ch-pchg-row" data-tf="15m"><span class="ch-pchg-check"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg></span><span class="ch-pchg-label">15 min</span></div>
              <div class="ch-pchg-row" data-tf="1d"><span class="ch-pchg-check"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg></span><span class="ch-pchg-label">24h</span></div>
            </div>
            <div class="ch-pp-item" data-param="volume">
              <span class="ch-pp-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="12" width="4" height="10"/><rect x="9" y="7" width="4" height="15"/><rect x="16" y="3" width="4" height="19"/></svg></span>
              <span class="ch-pp-label" data-param-label="volume">Volume</span>
              <svg class="ch-pp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 6 15 12 9 18"/></svg>
            </div>
            <div class="ch-pp-item" data-param="vol_spike">
              <span class="ch-pp-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><polyline points="2 20 6 10 10 16 14 4 18 12 22 8"/></svg></span>
              <span class="ch-pp-label" data-param-label="vol_spike">Volume spike</span>
              <svg class="ch-pp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 6 15 12 9 18"/></svg>
            </div>
            <div class="ch-pp-item" data-param="trade_spike">
              <span class="ch-pp-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
              <span class="ch-pp-label" data-param-label="trade_spike">Trade spike</span>
              <svg class="ch-pp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 6 15 12 9 18"/></svg>
            </div>
            <div class="ch-pp-item" data-param="trades">
              <span class="ch-pp-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg></span>
              <span class="ch-pp-label" data-param-label="trades">Trades</span>
              <svg class="ch-pp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 6 15 12 9 18"/></svg>
            </div>
            <div class="ch-pp-item" data-param="natr">
              <span class="ch-pp-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2 12h4l3-8 4 16 3-8h6"/></svg></span>
              <span class="ch-pp-label" data-param-label="natr">NATR</span>
              <svg class="ch-pp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 6 15 12 9 18"/></svg>
            </div>
          </div>
        </div>
