// ══ Floating dropdowns (portal → body, поверх всех секций) ═══
const _floatMenuOrigins = new WeakMap();

function getDropdownPortal() {
  let root = document.getElementById('dropdown-portal-root');
  if (!root) {
    root = document.createElement('div');
    root.id = 'dropdown-portal-root';
    document.body.appendChild(root);
  }
  return root;
}

function portalFloatMenu(menu) {
  if (!menu || menu.parentElement === getDropdownPortal()) return;
  _floatMenuOrigins.set(menu, { parent: menu.parentElement, next: menu.nextSibling });
  getDropdownPortal().appendChild(menu);
}

function restoreFloatMenuDom(menu) {
  if (!menu) return;
  const orig = _floatMenuOrigins.get(menu);
  if (orig?.parent) {
    if (orig.next && orig.next.parentNode === orig.parent) orig.parent.insertBefore(menu, orig.next);
    else orig.parent.appendChild(menu);
  }
  _floatMenuOrigins.delete(menu);
}

function positionFloatMenu(menu, anchor, opts = {}) {
  if (!menu || !anchor) return;
  portalFloatMenu(menu);
  menu.classList.add('dropdown-float');
  menu.style.display = 'block';
  const gap = opts.gap ?? 6;
  const r = anchor.getBoundingClientRect();
  const minW = opts.minWidth ?? Math.max(r.width, 150);
  menu.style.minWidth = minW + 'px';
  menu.style.top = (r.bottom + gap) + 'px';
  if (opts.alignRight !== false) {
    menu.style.left = 'auto';
    menu.style.right = (window.innerWidth - r.right) + 'px';
  } else {
    menu.style.left = r.left + 'px';
    menu.style.right = 'auto';
  }
}

function resetFloatMenu(menu) {
  if (!menu) return;
  menu.classList.remove('dropdown-float');
  menu.style.display = 'none';
  menu.style.top = menu.style.left = menu.style.right = menu.style.minWidth = '';
  restoreFloatMenuDom(menu);
}

function closeAllTopbarDropdowns() {
  closeWsMenu();
  const themeWrap = document.getElementById('sb-theme-wrap');
  const langWrap  = document.getElementById('sb-lang-wrap');
  const profileWrap = document.getElementById('tb-profile-wrap');
  if (themeWrap) themeWrap.classList.remove('open');
  if (langWrap)  langWrap.classList.remove('open');
  if (profileWrap) profileWrap.classList.remove('open');
  resetFloatMenu(document.getElementById('sb-theme-menu'));
  resetFloatMenu(document.getElementById('sb-lang-menu'));
  resetFloatMenu(document.getElementById('tb-profile-menu'));
}

function repositionOpenFloatMenus() {
  document.querySelectorAll('.dropdown-float').forEach(menu => {
    let anchor = null;
    if (menu.id === 'ws-menu') anchor = document.getElementById('ws-trigger');
    else if (menu.id === 'sb-theme-menu') anchor = document.getElementById('sb-theme-btn');
    else if (menu.id === 'sb-lang-menu') anchor = document.getElementById('sb-lang-btn');
    else if (menu.id === 'tb-profile-menu') anchor = document.getElementById('tb-profile-btn');
    else if (menu.classList.contains('fdd-menu')) {
      const id = menu.id.replace('fdd-', '').replace('-menu', '');
      anchor = document.getElementById('fdd-' + id + '-trigger');
    }
    if (anchor) positionFloatMenu(menu, anchor, { minWidth: menu.offsetWidth || anchor.offsetWidth });
  });
}

window.addEventListener('resize', repositionOpenFloatMenus);
window.addEventListener('scroll', repositionOpenFloatMenus, true);

// ══ Workspace ════════════════════════════════════════════════


// (workspaces and wsActive already declared at top of script)





function saveWorkspaces() {


  localStorage.setItem('crypto_workspaces', JSON.stringify(workspaces));


  localStorage.setItem('crypto_ws_active',  String(wsActive));


}





function updateWsTrigger() {
  const nameEl = document.getElementById('ws-name');
  if (nameEl) nameEl.textContent = wsDisplayName(workspaces[wsActive] || 'Workspace 1');
  const numEl = document.getElementById('ws-num');
  if (numEl) numEl.textContent = String(wsActive + 1);
}

function renderWsList() {


  const list = document.getElementById('ws-list');


  list.innerHTML = '';


  const countEl = document.getElementById('ws-count');


  if (countEl) countEl.textContent = `${workspaces.length}/${WS_MAX}`;

  updateWsTrigger();


  workspaces.forEach((name, i) => {


    const el = document.createElement('div');


    el.className = 'ws-item' + (i === wsActive ? ' active' : '');


    el.innerHTML = `<div class="ws-item-dot"></div><span>${wsDisplayName(name)}</span>`;


    el.addEventListener('click', () => {
      saveSettings();
      wsActive = i;
      saveWorkspaces();
      settings = loadSettings(i);
      soundOn     = settings.soundOn !== false;
      soundVolume = settings.soundVolume ?? 20;
      soundType   = settings.soundType   || 'chime';
      updateWsTrigger();
      closeWsMenu();
      [...symCards.keys()].forEach(sym => renderCard(sym));
      reorderGrid(); updateStats();
    });


    list.appendChild(el);


  });


}





function openWsMenu() {
  renderWsList();
  const menu = document.getElementById('ws-menu');
  const trigger = document.getElementById('ws-trigger');
  positionFloatMenu(menu, trigger, { minWidth: 180 });
  document.getElementById('ws-chevron').classList.add('open');
  document.getElementById('ws-trigger').classList.add('open');
}


function closeWsMenu() {
  const menu = document.getElementById('ws-menu');
  if (menu && menu.classList.contains('dropdown-float')) resetFloatMenu(menu);
  else if (menu) menu.style.display = 'none';
  document.getElementById('ws-chevron')?.classList.remove('open');
  document.getElementById('ws-trigger')?.classList.remove('open');
}





document.getElementById('ws-trigger').addEventListener('click', e => {


  e.stopPropagation();


  const open = document.getElementById('ws-menu')?.classList.contains('dropdown-float');


  if (open) closeWsMenu();
  else {
    closeAllTopbarDropdowns();
    openWsMenu();
  }


});


document.getElementById('ws-menu').addEventListener('click', e => e.stopPropagation());


document.addEventListener('click', closeWsMenu);





// Rename


document.getElementById('ws-rename-btn').addEventListener('click', () => {


  closeWsMenu();


  const nameEl  = document.getElementById('ws-name');


  const current = workspaces[wsActive];


  const inp     = document.createElement('input');


  inp.value     = current;


  inp.style.cssText = 'background:transparent;border:none;outline:none;color:var(--text);font-size:13px;font-weight:600;width:130px;';


  nameEl.textContent = '';


  nameEl.appendChild(inp);


  inp.focus(); inp.select();





  function commit() {


    const val = inp.value.trim() || current;


    workspaces[wsActive] = val;


    saveWorkspaces();


    nameEl.textContent = val;


  }


  inp.addEventListener('keydown', e => {


    if (e.key === 'Enter')  { commit(); inp.blur(); }


    if (e.key === 'Escape') { nameEl.textContent = current; }


  });


  inp.addEventListener('blur', commit);


});





// Create


document.getElementById('ws-create-btn').addEventListener('click', () => {


  closeWsMenu();


  const name = `Workspace ${workspaces.length + 1}`;


  workspaces.push(name);


  wsActive = workspaces.length - 1;


  saveWorkspaces();


  updateWsTrigger();


});


// Delete workspace
document.getElementById('ws-delete-btn').addEventListener('click', () => {
  closeWsMenu();
  if (workspaces.length <= 1) return;
  workspaces.splice(wsActive, 1);
  wsActive = Math.min(wsActive, workspaces.length - 1);
  saveWorkspaces();
  settings = loadSettings(wsActive);
  soundOn     = settings.soundOn !== false;
  soundVolume = settings.soundVolume ?? 20;
  soundType   = settings.soundType   || 'chime';
  updateWsTrigger();
  renderWsList();
  [...symCards.keys()].forEach(sym => renderCard(sym));
  reorderGrid(); updateStats();
});





// Init name
updateWsTrigger();





// ══ Spike ═════════════════════════════════════════════


const SPLASH_LABELS    = ['2','5','7','12'];


const SPLASH_ACT_KEY   = 'crypto_splash_active_v1';


const SPLASH_CARDS_KEY   = 'crypto_splash_cards_v2';   // v2: clears old 0-vol cache
const SPLASH_HISTORY_KEY = 'crypto_spike_history_v1';  // accumulative, never cleared by user


const SPLASH_MINVOL_KEY= 'crypto_splash_minvol_v1';


const SPLASH_MAX       = 50;
const SPLASH_COL_MAX   = 50;
const SPLASH_EXCHS     = ['binance','bybit','okx','gate','bitget'];
const SPLASH_EXCH_KEY  = 'crypto_splash_exch_v1';
function loadSplashExch() {
  try { const s = JSON.parse(localStorage.getItem(SPLASH_EXCH_KEY)||'null'); if(s) return s; } catch(e){}
  return Object.fromEntries(SPLASH_EXCHS.map(e => [e, true]));
}
function saveSplashExch() { localStorage.setItem(SPLASH_EXCH_KEY, JSON.stringify(splashExchActive)); }
let splashExchActive = loadSplashExch();


const SPLASH_BUF       = 5000;


const SPLASH_TRIM      = 4000;





function loadSplashActive() {


  try { const s = JSON.parse(localStorage.getItem(SPLASH_ACT_KEY)||'null'); if(s) return s; } catch(e){}


  return {'2':false,'5':true,'7':true,'12':true};


}


function saveSplashActive() { localStorage.setItem(SPLASH_ACT_KEY, JSON.stringify(splashActive)); }


function loadSplashCards()  {


  try { return JSON.parse(localStorage.getItem(SPLASH_CARDS_KEY)||'[]'); } catch(e){ return []; }


}


function saveSplashCards()  { localStorage.setItem(SPLASH_CARDS_KEY, JSON.stringify(splashCards)); }

// Accumulative history — only label='2' events, never cleared by user, used for Top Mover
let splashHistory = (function() {
  try { return JSON.parse(localStorage.getItem(SPLASH_HISTORY_KEY) || '[]'); } catch(e) { return []; }
})();
function _pushSplashHistory(ev) {
  if (ev.label !== '2') return;
  splashHistory.push(ev.symbol);          // store only symbol string — tiny footprint
  if (splashHistory.length > SPLASH_BUF) splashHistory.splice(0, splashHistory.length - SPLASH_TRIM);
  try { localStorage.setItem(SPLASH_HISTORY_KEY, JSON.stringify(splashHistory)); } catch(e) {}
}





let splashActive  = loadSplashActive();


let splashCards   = loadSplashCards();


let splashMinVol  = parseFloat(localStorage.getItem(SPLASH_MINVOL_KEY) || '0') || 0; // in K$


let activeSection = localStorage.getItem('crypto_section') || 'charts';

