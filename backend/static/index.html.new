        <span class="fdd-chevron"><svg width="9" height="6" viewBox="0 0 9 6" fill="none"><path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
      </div>
      <div class="fdd-menu" id="fdd-market-menu" style="display:none">
