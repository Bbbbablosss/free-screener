"""
MarketDataService: fetches Binance Futures 24h tickers every 60 seconds,
broadcasts a market_data WebSocket message to all connected clients.
"""
import asyncio
import json
import logging
import time

import aiohttp

logger = logging.getLogger(__name__)

_session: aiohttp.ClientSession | None = None


async def _get_session() -> aiohttp.ClientSession:
    global _session
    if _session is None or _session.closed:
        _session = aiohttp.ClientSession()
    return _session


class MarketDataService:
    def __init__(self):
        self.pairs: dict[str, dict] = {}   # symbol -> {price, change_pct, volume_usd}
        self.total_pairs: int = 0
        self.gainers: int = 0
        self.losers: int = 0
        self.total_vol: float = 0.0
        self._last_fetch: float = 0.0
        self._ws_clients: set = set()       # injected from main.py

    def snapshot(self) -> dict:
        return {
            "type": "market_data",
            "stats": {
                "total_pairs": self.total_pairs,
                "gainers": self.gainers,
                "losers": self.losers,
                "total_vol": self.total_vol,
            },
            "pairs": [
                {"s": sym, "p": v["price"], "c": v["change_pct"], "v": v["volume_usd"]}
                for sym, v in sorted(
                    self.pairs.items(), key=lambda x: -x[1]["volume_usd"]
                )
            ],
        }

    async def _fetch(self):
        session = await _get_session()
        url = "https://fapi.binance.com/fapi/v1/ticker/24hr"
        try:
            async with session.get(url, timeout=aiohttp.ClientTimeout(total=20)) as r:
                data = await r.json()
        except Exception as e:
            logger.warning("Market data fetch error: %s", e)
            return

        pairs: dict[str, dict] = {}
        gainers = losers = 0
        total_vol = 0.0

        for t in data:
            sym: str = t["symbol"]
            if not sym.endswith("USDT"):
                continue
            cp = float(t["priceChangePercent"])
            vol = float(t["quoteVolume"])
            pairs[sym] = {
                "price": float(t["lastPrice"]),
                "change_pct": cp,
                "volume_usd": vol,
            }
            if cp > 0:
                gainers += 1
            elif cp < 0:
                losers += 1
            total_vol += vol

        self.pairs = pairs
        self.total_pairs = len(pairs)
        self.gainers = gainers
        self.losers = losers
        self.total_vol = total_vol
        self._last_fetch = time.time()
        logger.info("Market data updated: %d pairs, gainers=%d, losers=%d", len(pairs), gainers, losers)

        # Broadcast to all connected WebSocket clients
        if self._ws_clients:
            msg = json.dumps(self.snapshot())
            dead = set()
            for ws in list(self._ws_clients):
                try:
                    await ws.send_text(msg)
                except Exception:
                    dead.add(ws)
            self._ws_clients -= dead

    async def start(self):
        while True:
            await self._fetch()
            await asyncio.sleep(60)


market_data = MarketDataService()
