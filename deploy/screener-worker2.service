[Unit]
Description=Crypto Screener — ingestion worker 2 (binance, bybit, bitget, mexc, kucoin)
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/screener
Environment=ROLE=worker
Environment=WORKER_EXCHANGES=binance,bybit,bitget,mexc,kucoin
ExecStart=/opt/screener/venv/bin/python run_worker.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
