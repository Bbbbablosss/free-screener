[Unit]
Description=Free Screener web application
After=network-online.target free-screener-redis.service
Requires=free-screener-redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/free-screener
EnvironmentFile=/opt/free-screener/deploy/free/free-screener.env
ExecStart=/opt/free-screener/venv/bin/python /opt/free-screener/run.py
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

